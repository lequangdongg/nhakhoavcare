---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MapSection from '../components/MapSection.astro';
import PricePreview from '../components/PricePreview.astro';
import Container from '../components/Container.astro';
import ServiceCards from '../components/ServiceCards.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import SiteImage from '../components/SiteImage.astro';
import { Icon } from 'astro-icon/components';
import { clinic } from '../data/clinic';
import { pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

const locale = 'vi' as const;

const t = useTranslations(locale);
const serviceCount = (await getCollection('services', (e) => e.data.lang === locale)).length;

/** Bốn bước điều trị Implant. Nhãn là hành động thật, không đánh số. */
const implantSteps = [
  {
    title: 'Khám và chụp phim',
    body: 'Chụp CT dựng hình để đo chính xác chiều cao và mật độ xương hàm tại vị trí mất răng.',
  },
  {
    title: 'Đặt trụ',
    body: 'Trụ titanium được đặt vào xương hàm. Thủ thuật gây tê tại chỗ, thực hiện trong một buổi.',
  },
  {
    title: 'Chờ tích hợp xương',
    body: 'Xương phát triển bám vào bề mặt trụ. Đây là giai đoạn dài nhất và không rút ngắn được.',
  },
  {
    title: 'Gắn mão sứ',
    body: 'So màu răng thật của bạn, chế tác mão sứ theo đúng sắc độ đó rồi gắn lên trụ.',
  },
];
---

<BaseLayout
  locale={locale}
  title={`${clinic.name}. Nha khoa tại Đà Nẵng`}
  description="Phòng khám nha khoa tại Đà Nẵng, chuyên sâu cấy ghép Implant. Bảng giá công khai, quy trình rõ ràng, bảo hành bằng văn bản."
>
  {/* ── Hero. Bố cục lệch, chữ bên trái, khung ảnh bên phải. ───────────────── */}
  <Hero locale={locale} serviceCount={serviceCount} />

  <section aria-labelledby="dich-vu" data-part="services" class="reveal border-b border-steel">
    <Container class="reveal py-14 lg:py-20">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 id="dich-vu" class="text-2xl font-semibold md:text-3xl">Dịch vụ</h2>
        <a
          href={pathFor('services', locale)}
          class="inline-flex link-slide items-center gap-1.5 text-ink-2"
        >
          Xem tất cả
          <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>

      <ServiceCards locale={locale} />
    </Container>
  </section>

  {/* ── Implant. Khối rộng, nền chìm, nói thẳng vào định vị. ───────────────── */}
  <section
    aria-labelledby="implant"
    data-part="implant"
    class="reveal border-b border-steel bg-surface-sunken"
  >
    <Container class="reveal py-14 lg:py-20">
      <div class="max-w-[52ch]">
        <h2 id="implant" class="text-2xl font-semibold md:text-3xl">
          Cấy ghép Implant là việc chúng tôi làm nhiều nhất
        </h2>
        <p class="mt-4 text-ink-2">
          Trụ titanium thay chân răng đã mất. Ăn nhai như răng thật, không mài răng bên cạnh, không
          tháo ra lắp vào.
        </p>
      </div>

      {/* Bốn bước theo lưới ngang, phân tách bằng đường thép chứ không dùng thẻ. */}
      <ol
        class="mt-10 grid gap-px bg-steel sm:grid-cols-2 lg:grid-cols-4 [[data-layout=stack]_&]:grid-cols-1"
      >
        {
          implantSteps.map((step) => (
            <li class="bg-surface-sunken p-5 lg:p-6">
              <h3 class="text-base font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <a
        href={pathFor('service:implant', locale)}
        class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-full border border-steel-edge px-5 transition-colors duration-300 hover:bg-surface active:translate-y-px"
      >
        <span class="font-medium">Chi tiết về Implant</span>
        <Icon name="ph:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
      </a>
    </Container>
  </section>

  {/* ── Gallery trước/sau. Khung nền sáng ở cả hai chế độ màu. ─────────────── */}
  <section aria-labelledby="ket-qua" data-part="results" class="reveal border-b border-steel">
    <Container wide class="py-14 lg:py-20">
      <h2 id="ket-qua" class="text-2xl font-semibold md:text-3xl">Kết quả điều trị</h2>
      <p class="mt-3 max-w-[62ch] text-ink-2">
        Ảnh trước và sau chụp cùng góc, cùng ánh sáng, cùng khoảng cách. Kéo thanh giữa ảnh để so
        sánh.
      </p>

      <div
        class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4 [[data-layout=stack]_&]:grid-cols-1"
      >
        <BeforeAfter
          before="caseImplantBefore"
          after="caseImplantAfter"
          caption={t('ba.implant')}
          labelBefore={t('ba.before')}
          labelAfter={t('ba.after')}
        />
        <BeforeAfter
          before="caseVeneerBefore"
          after="caseVeneerAfter"
          caption={t('ba.veneer')}
          labelBefore={t('ba.before')}
          labelAfter={t('ba.after')}
        />
        <BeforeAfter
          before="caseBracesBefore"
          after="caseBracesAfter"
          caption={t('ba.braces')}
          labelBefore={t('ba.before')}
          labelAfter={t('ba.after')}
        />
        <BeforeAfter
          before="caseWhiteningBefore"
          after="caseWhiteningAfter"
          caption={t('ba.whitening')}
          labelBefore={t('ba.before')}
          labelAfter={t('ba.after')}
        />
      </div>
    </Container>
  </section>

  {/* ── Bảng giá. Khối chữ đơn, dẫn sang trang giá. ────────────────────────── */}
  <section
    aria-labelledby="gia"
    data-part="pricing"
    class="reveal border-b border-steel [[data-layout=list]_&]:-order-1"
  >
    <Container class="py-14 lg:py-20">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-[52ch]">
          <h2 id="gia" class="text-2xl font-semibold md:text-3xl">{t('home.priceTitle')}</h2>
          <p class="mt-3 text-ink-2">{t('home.priceIntro')}</p>
        </div>
        <a
          href={pathFor('pricing', locale)}
          class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-accent px-5 text-accent-contrast transition-colors duration-300 hover:bg-accent-hover active:translate-y-px"
        >
          <span class="font-medium">{t('home.priceAll')}</span>
          <Icon name="ph:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
        </a>
      </div>

      <PricePreview locale={locale} />
    </Container>
  </section>
  <div data-part="map" class="[[data-layout=mapfirst]_&]:-order-1">
    <MapSection locale={locale} />
  </div>
</BaseLayout>
