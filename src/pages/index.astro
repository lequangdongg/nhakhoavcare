---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import ShadeScale from '../components/ShadeScale.astro';
import ActionBar from '../components/ActionBar.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { Icon } from 'astro-icon/components';
import { clinic } from '../data/clinic';
import { pathFor } from '../i18n/routes';

const locale = 'vi' as const;

/**
 * Dải sắc độ dùng làm điều hướng dịch vụ. Mã tab là mã VITA thật; thứ tự đi từ
 * sáng nhất tới sẫm nhất, đúng cách bộ so màu được sắp trên khung.
 */
const shadeTabs = [
  { key: 'whitening', code: 'B1', label: 'Tẩy trắng răng', shade: 'var(--shade-b1)' },
  { key: 'veneer', code: 'A1', label: 'Dán sứ Veneer', shade: 'var(--shade-a1)' },
  { key: 'crown', code: 'A2', label: 'Bọc răng sứ', shade: 'var(--shade-a2)' },
  { key: 'implant', code: 'B3', label: 'Cấy ghép Implant', shade: 'var(--shade-b3)' },
  { key: 'braces', code: 'A3', label: 'Niềng răng', shade: 'var(--shade-a3)' },
  { key: 'scaling', code: 'C3', label: 'Lấy cao răng', shade: 'var(--shade-c3)' },
] as const;

/** Bốn bước điều trị Implant. Nhãn là hành động thật, không đánh số. */
const implantSteps = [
  {
    title: 'Khám và chụp phim',
    body: 'Chụp CT dựng hình để đo chính xác chiều cao và mật độ xương hàm tại vị trí mất răng.',
  },
  {
    title: 'Đặt trụ',
    body: 'Trụ titanium được đặt vào xương hàm. Thủ thuật gây tê tại chỗ, thực hiện trong một buổi.',
  },
  {
    title: 'Chờ tích hợp xương',
    body: 'Xương phát triển bám vào bề mặt trụ. Đây là giai đoạn dài nhất và không rút ngắn được.',
  },
  {
    title: 'Gắn mão sứ',
    body: 'So màu răng thật của bạn, chế tác mão sứ theo đúng sắc độ đó rồi gắn lên trụ.',
  },
];
---

<BaseLayout
  locale={locale}
  title={`${clinic.name}. Nha khoa tại Đà Nẵng`}
  description="Phòng khám nha khoa tại Đà Nẵng, chuyên sâu cấy ghép Implant. Bảng giá công khai, quy trình rõ ràng, bảo hành bằng văn bản."
>
  {/* ── Hero. Bố cục lệch, chữ bên trái, khung ảnh bên phải. ───────────────── */}
  <section class="border-b border-steel">
    <Container
      class="grid items-center gap-10 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-20"
    >
      <div class="max-w-[36ch]">
        <h1 class="text-4xl leading-[1.08] font-semibold md:text-5xl lg:text-[3.4rem]">
          Răng mới phải khớp đúng màu răng bạn đang có
        </h1>
        <p class="mt-5 max-w-[46ch] text-lg text-ink-2">
          Phòng khám nha khoa tại Đà Nẵng, chuyên sâu cấy ghép Implant. Giá công khai, không phát
          sinh.
        </p>
        <ActionBar locale={locale} class="mt-8" />
      </div>

      <ImageSlot
        slot="hero"
        ratio="3/2"
        brief="Không gian phòng khám, ánh sáng tự nhiên, có bác sĩ đang làm việc trong khung hình"
      />
    </Container>
  </section>

  {/* ── Dải sắc độ làm điều hướng dịch vụ. Chữ ký thị giác, chỉ dùng một lần. ── */}
  <section aria-labelledby="dich-vu" class="border-b border-steel">
    <Container class="py-14 lg:py-20">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 id="dich-vu" class="text-2xl font-semibold md:text-3xl">Dịch vụ</h2>
        <a
          href={pathFor('services', locale)}
          class="inline-flex items-center gap-1.5 text-ink-2 underline-offset-4 transition-colors duration-300 hover:text-ink hover:underline"
        >
          Xem tất cả
          <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>

      <ShadeScale locale={locale} tabs={shadeTabs} />
    </Container>
  </section>

  {/* ── Implant. Khối rộng, nền chìm, nói thẳng vào định vị. ───────────────── */}
  <section aria-labelledby="implant" class="border-b border-steel bg-surface-sunken">
    <Container class="py-14 lg:py-20">
      <div class="max-w-[52ch]">
        <h2 id="implant" class="text-2xl font-semibold md:text-3xl">
          Cấy ghép Implant là việc chúng tôi làm nhiều nhất
        </h2>
        <p class="mt-4 text-ink-2">
          Trụ titanium thay chân răng đã mất. Ăn nhai như răng thật, không mài răng bên cạnh, không
          tháo ra lắp vào.
        </p>
      </div>

      {/* Bốn bước theo lưới ngang, phân tách bằng đường thép chứ không dùng thẻ. */}
      <ol class="mt-10 grid gap-px bg-steel sm:grid-cols-2 lg:grid-cols-4">
        {
          implantSteps.map((step) => (
            <li class="bg-surface-sunken p-5 lg:p-6">
              <h3 class="text-base font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <a
        href={pathFor('service:implant', locale)}
        class="mt-8 inline-flex min-h-11 items-center gap-2 border border-steel-edge px-5 transition-colors duration-300 hover:bg-surface active:translate-y-px"
      >
        <span class="font-medium">Chi tiết về Implant</span>
        <Icon name="ph:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
      </a>
    </Container>
  </section>

  {/* ── Gallery trước/sau. Khung nền sáng ở cả hai chế độ màu. ─────────────── */}
  <section aria-labelledby="ket-qua" class="border-b border-steel">
    <Container class="py-14 lg:py-20">
      <h2 id="ket-qua" class="text-2xl font-semibold md:text-3xl">Kết quả điều trị</h2>
      <p class="mt-3 max-w-[58ch] text-ink-2">
        Ảnh trước và sau chụp cùng góc, cùng ánh sáng, cùng khoảng cách. Vùng ảnh giữ nền sáng ở cả
        chế độ tối để màu răng không bị nhìn sai.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:max-w-3xl">
        <ImageSlot
          slot="case-before"
          ratio="1/1"
          brief="Ảnh trước điều trị. Ghi lại thông số máy ảnh để chụp ảnh sau giống hệt."
          clinical
        />
        <ImageSlot
          slot="case-after"
          ratio="1/1"
          brief="Ảnh sau điều trị. Cùng góc, cùng ánh sáng, cùng khoảng cách."
          clinical
        />
      </div>
    </Container>
  </section>

  {/* ── Bảng giá. Khối chữ đơn, dẫn sang trang giá. ────────────────────────── */}
  <section aria-labelledby="gia" class="border-b border-steel">
    <Container
      class="flex flex-col items-start gap-6 py-14 lg:flex-row lg:items-center lg:justify-between lg:py-20"
    >
      <div class="max-w-[46ch]">
        <h2 id="gia" class="text-2xl font-semibold md:text-3xl">Giá công khai, không phát sinh</h2>
        <p class="mt-3 text-ink-2">
          Toàn bộ chi phí ghi rõ trước khi bắt đầu. Chính sách bảo hành viết thành văn bản, không
          hứa miệng.
        </p>
      </div>
      <a
        href={pathFor('pricing', locale)}
        class="inline-flex min-h-11 shrink-0 items-center gap-2 bg-accent px-5 text-accent-contrast transition-colors duration-300 hover:bg-accent-hover active:translate-y-px"
      >
        <span class="font-medium">Xem bảng giá</span>
        <Icon name="ph:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
      </a>
    </Container>
  </section>
</BaseLayout>
