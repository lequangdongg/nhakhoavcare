---
import '../styles/global.css';
import ThemeScript from '../components/ThemeScript.astro';
import StructuredData from '../components/StructuredData.astro';
import StickyActions from '../components/StickyActions.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LAYOUT, DEFAULT_SKIN } from '../lib/appearance';
import { alternateLinks } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Trang chi tiết dịch vụ truyền vào để sinh MedicalProcedure và FAQPage. */
  service?: CollectionEntry<'services'>;
  doctors?: CollectionEntry<'doctors'>[];
}

const { locale, title, description, service, doctors } = Astro.props;
const t = useTranslations(locale);
const alternates = alternateLinks(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * Bốn bố cục tác động ở cấp <main>.
 *
 * list và mapfirst đổi thứ tự NHÌN THẤY bằng flex order. Thứ tự trong DOM giữ
 * nguyên, nên trình đọc màn hình và công cụ tìm kiếm vẫn nhận đúng một mạch
 * nội dung. Đây là lý do dùng order chứ không phải dựng ba bản markup.
 */
const MAIN_BY_LAYOUT = [
  '[[data-layout=list]_&]:flex [[data-layout=list]_&]:flex-col',
  '[[data-layout=mapfirst]_&]:flex [[data-layout=mapfirst]_&]:flex-col',
  // card: mỗi khối thành một thẻ nổi trên nền chìm, kiểu bento. Hero giữ
  // nguyên tràn viền để màn hình đầu tiên vẫn liền mạch.
  '[[data-layout=card]_&]:bg-surface-sunken',
  '[[data-layout=card]_&]:[&>:is(section,div):not([data-part=hero])]:mx-auto',
  '[[data-layout=card]_&]:[&>:is(section,div):not([data-part=hero])]:my-5',
  '[[data-layout=card]_&]:[&>:is(section,div):not([data-part=hero])]:max-w-[1400px]',
  '[[data-layout=card]_&]:[&>:is(section,div):not([data-part=hero])]:overflow-hidden',
  // Ghi đè border-b của từng khối: viền một cạnh trên một cái thẻ trông như lỗi
  '[[data-layout=card]_&]:[&>:is(section,div):not([data-part=hero])]:rounded-lg',
  '[[data-layout=card]_&]:[&>:is(section,div):not([data-part=hero])]:border',
  '[[data-layout=card]_&]:[&>:is(section,div):not([data-part=hero])]:border-steel',
  '[[data-layout=card]_&]:[&>:is(section,div):not([data-part=hero])]:bg-surface-raised',
  // magazine: nền xen kẽ giữa các khối, đọc như một bài viết.
  // nth-of-type chứ không phải nth-child: <main> còn chứa khối bản đồ bọc
  // trong thẻ div, đếm theo child sẽ lệch một nhịp.
  '[[data-layout=magazine]_&]:[&>section:nth-of-type(2n)]:bg-surface-sunken',
].join(' ');
---

<!doctype html>
<html lang={locale} data-theme={DEFAULT_SKIN} data-layout={DEFAULT_LAYOUT}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Favicon dạng SVG: một file cho mọi kích thước, tự sắc nét ở mọi độ phân giải */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2563EB" />

    {/* hreflang trỏ đúng trang tương ứng, không phải trang chủ — nhờ routes.ts */}
    {
      alternates.map(({ locale: alt, path }) => (
        <link rel="alternate" hreflang={alt} href={new URL(path, Astro.site).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates[0]!.path, Astro.site).href}
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />

    <StructuredData locale={locale} service={service} doctors={doctors} />
    <ThemeScript />

    {
      /*
      Đánh dấu có JavaScript, để CSS biết được phép giấu nội dung chờ hiện dần.
      Không có dòng này thì trình duyệt tắt JS sẽ thấy trang trắng trơn.
    */
    }
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="pb-[4.75rem] lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only">{t('nav.skipToContent')}</a>
    <Header locale={locale} />
    <main id="main" data-part="main" class={MAIN_BY_LAYOUT}>
      <slot />
    </main>
    <Footer locale={locale} />
    <StickyActions locale={locale} />

    {
      /*
      Dự phòng hiệu ứng cuộn cho Safari và Firefox, nơi animation-timeline: view()
      chưa được hỗ trợ. Chrome bỏ qua nhánh này vì CSS đã lo.
    */
    }
    <script is:inline>
      (() => {
        if (CSS.supports('animation-timeline: view()')) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          for (const el of document.querySelectorAll('.reveal')) el.classList.add('in-view');
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in-view');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        for (const el of document.querySelectorAll('.reveal')) io.observe(el);
      })();
    </script>
  </body>
</html>
