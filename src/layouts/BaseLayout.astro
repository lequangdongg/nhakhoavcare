---
import '../styles/global.css';
import ThemeScript from '../components/ThemeScript.astro';
import StructuredData from '../components/StructuredData.astro';
import StickyActions from '../components/StickyActions.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { alternateLinks } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Trang chi tiết dịch vụ truyền vào để sinh MedicalProcedure và FAQPage. */
  service?: CollectionEntry<'services'>;
  doctors?: CollectionEntry<'doctors'>[];
}

const { locale, title, description, service, doctors } = Astro.props;
const t = useTranslations(locale);
const alternates = alternateLinks(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Favicon dạng SVG: một file cho mọi kích thước, tự sắc nét ở mọi độ phân giải */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2563EB" />

    {/* hreflang trỏ đúng trang tương ứng, không phải trang chủ — nhờ routes.ts */}
    {
      alternates.map(({ locale: alt, path }) => (
        <link rel="alternate" hreflang={alt} href={new URL(path, Astro.site).href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates[0]!.path, Astro.site).href}
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />

    <StructuredData locale={locale} service={service} doctors={doctors} />
    <ThemeScript />
  </head>
  <body class="pb-[4.75rem] lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only">{t('nav.skipToContent')}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <StickyActions locale={locale} />
  </body>
</html>
