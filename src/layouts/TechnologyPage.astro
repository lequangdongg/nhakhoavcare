---
import { Icon } from 'astro-icon/components';
import Container from '../components/Container.astro';
import SiteImage from '../components/SiteImage.astro';
import { TECH } from '../data/copy/technology';
import type { Locale } from '../i18n/locales';
import { pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const c = TECH[locale];
---

<BaseLayout locale={locale} title={`${t('tech.title')}. ${t('brand.short')}`} description={c.lede}>
  <Container class="py-12 lg:py-16">
    <h1 class="max-w-[20ch] text-3xl font-semibold text-balance md:text-4xl lg:text-[2.75rem]">
      {t('tech.title')}
    </h1>
    <p class="mt-4 max-w-[62ch] text-lg text-ink-2">{c.lede}</p>
  </Container>

  <section aria-labelledby="chan-doan" class="reveal border-y border-steel bg-surface-sunken">
    <Container class="py-14 lg:py-20">
      <div
        class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-14 [[data-layout=stack]_&]:grid-cols-1"
      >
        <div>
          <h2 id="chan-doan" class="text-2xl font-semibold md:text-3xl">{c.imagingTitle}</h2>
          {c.imaging.map((p) => <p class="mt-4 max-w-[58ch] text-ink-2">{p}</p>)}
        </div>
        <SiteImage name="ctScanner" class="lg:mt-1" />
      </div>

      <h3 class="mt-14 text-xl font-semibold">{c.modesTitle}</h3>
      <p class="mt-3 max-w-[62ch] text-ink-2">{c.modesLede}</p>

      {
        /*
        Bảng chứ không phải thẻ: mỗi dòng là một cặp "chế độ → trả lời câu gì".
        Đó là quan hệ hai cột, và bảng nói đúng quan hệ đó hơn ba ô cạnh nhau.
      */
      }
      <dl class="mt-6 divide-y divide-steel border-y border-steel">
        {
          c.modes.map((m) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-6">
              <dt class="font-semibold">{m.name}</dt>
              <dd class="max-w-[58ch] text-ink-2">{m.question}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-6 max-w-[62ch] text-ink-2">{c.onSite}</p>
    </Container>
  </section>

  <section aria-labelledby="tia-x" class="reveal border-b border-steel">
    <Container class="py-14 lg:py-20">
      <div
        class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-14 [[data-layout=stack]_&]:grid-cols-1"
      >
        <div>
          <h2 id="tia-x" class="max-w-[24ch] text-2xl font-semibold text-balance md:text-3xl">
            {c.radiationTitle}
          </h2>
          <p class="mt-4 max-w-[58ch] text-ink-2">{c.radiationLede}</p>

          <ul class="mt-6 max-w-[58ch] space-y-3">
            {
              c.radiation.map((r) => (
                <li class="flex gap-3 text-ink-2">
                  <Icon
                    name="ph:check-circle"
                    class="text-success mt-0.5 size-5 shrink-0"
                    aria-hidden="true"
                  />
                  <span>{r}</span>
                </li>
              ))
            }
          </ul>

          <p class="mt-6 max-w-[58ch] border-s-2 border-accent ps-5 text-ink">{c.radiationAsk}</p>
        </div>

        <SiteImage name="leadApron" class="lg:mt-1" />
      </div>

      <h3 class="mt-14 text-xl font-semibold">{c.impactedTitle}</h3>
      {c.impacted.map((p) => <p class="mt-4 max-w-[62ch] text-ink-2">{p}</p>)}
    </Container>
  </section>

  <section aria-labelledby="nha-khoa-so" class="reveal border-b border-steel bg-surface-sunken">
    <Container wide class="py-14 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14 [[data-layout=stack]_&]:grid-cols-1">
        <div>
          <h2 id="nha-khoa-so" class="text-2xl font-semibold md:text-3xl">{c.scanTitle}</h2>
          <p class="mt-4 max-w-[58ch] text-ink-2">{c.scanLede}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:content-start">
          <SiteImage name="iteroScan" />
          <SiteImage name="iteroScreen" />
        </div>
      </div>

      <h3 class="mt-14 text-xl font-semibold">{c.benefitsTitle}</h3>
      <ol
        class="mt-6 grid gap-px bg-steel sm:grid-cols-2 lg:grid-cols-4 [[data-layout=stack]_&]:grid-cols-1"
      >
        {
          c.benefits.map((b) => (
            <li class="bg-surface-sunken p-5 lg:p-6">
              <h4 class="text-base font-semibold">{b.name}</h4>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">{b.body}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <section aria-labelledby="du-lieu" class="reveal">
    <Container class="py-14 lg:py-20">
      <h2 id="du-lieu" class="text-2xl font-semibold md:text-3xl">{c.recordsTitle}</h2>
      {c.records.map((p) => <p class="mt-4 max-w-[62ch] text-ink-2">{p}</p>)}

      <a
        href={pathFor('service:braces', locale)}
        class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-full border border-steel-edge px-5 transition-colors duration-300 hover:bg-surface-sunken active:translate-y-px"
      >
        <span class="font-medium">{c.bracesLink}</span>
        <Icon name="ph:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
      </a>
    </Container>
  </section>
</BaseLayout>
