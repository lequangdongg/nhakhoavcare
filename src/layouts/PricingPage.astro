---
/**
 * Trang bảng giá.
 *
 * Bố cục theo mẫu tham khảo: bốn dịch vụ nổi bật thành thẻ có giá lớn và vài
 * gạch đầu dòng, phần còn lại thành danh sách hai cột, cuối là khối cam kết.
 *
 * Hai chỗ tôi KHÔNG làm theo mẫu:
 *
 * 1. Mẫu dùng bốn màu khác nhau cho bốn thẻ (xanh dương, xanh lá, cam, tím).
 *    Bảng màu đã chốt chỉ có hai màu nhấn, và Taste bắt khoá một màu cho cả
 *    trang. Ở đây dùng một màu, phân biệt thẻ trọng tâm bằng viền đậm.
 *
 * 2. Mẫu ghi những lời hứa như "Bảo hành trọn đời", "Bền đẹp đến 15 năm",
 *    "Trụ Implant chính hãng". Đó là cam kết riêng của phòng khám mà tôi không
 *    được bịa. Gạch đầu dòng ở đây chỉ nói sự thật chung về kỹ thuật, lấy từ
 *    chính nội dung đã viết cho từng trang dịch vụ.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import ActionBar from '../components/ActionBar.astro';
import Container from '../components/Container.astro';
import { clinic, telHref } from '../data/clinic';
import type { Locale } from '../i18n/locales';
import { type ServiceKey, pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const all = (await getCollection('services', (e) => e.data.lang === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
const byKey = Object.fromEntries(all.map((s) => [s.data.key, s]));
const fmt = new Intl.NumberFormat(locale === 'vi' ? 'vi-VN' : 'en-US');

const FEATURED = [
  {
    key: 'implant',
    unit: t('pr.unitTru'),
    points:
      locale === 'vi'
        ? [
            'Không mài hai răng bên cạnh',
            'Cố định, không tháo ra ban đêm',
            'Cần chụp CT trước khi làm',
          ]
        : [
            'Neighbouring teeth left untouched',
            'Fixed in place, stays in at night',
            'Needs a CT scan first',
          ],
  },
  {
    key: 'veneer',
    unit: t('pr.unitRang'),
    points:
      locale === 'vi'
        ? [
            'Chỉ mài mặt ngoài, giữ phần lớn mô răng',
            'Chỉnh màu và hình dáng răng cửa',
            'Không hợp với răng đã trám lớn',
          ]
        : [
            'Only the outer face is prepared',
            'Changes colour and shape',
            'Not for heavily filled teeth',
          ],
  },
  {
    key: 'crown',
    unit: t('pr.unitRang'),
    points:
      locale === 'vi'
        ? ['Chụp toàn bộ thân răng', 'Cần thiết sau khi chữa tủy', 'Zirconia bền nhất cho răng hàm']
        : ['Covers the whole tooth', 'Needed after root canal', 'Zirconia is strongest for molars'],
  },
  {
    key: 'braces',
    unit: t('pr.unitGoi'),
    points:
      locale === 'vi'
        ? [
            'Thường kéo dài một tới ba năm',
            'Người lớn lâu hơn trẻ em',
            'Bắt buộc đeo hàm duy trì sau đó',
          ]
        : [
            'Usually one to three years',
            'Adults take longer than children',
            'A retainer afterwards is required',
          ],
  },
] as const;

const featuredKeys = new Set<string>(FEATURED.map((f) => f.key));
const others = all.filter((s) => !featuredKeys.has(s.data.key));
const commitments = [t('pricing.c1'), t('pricing.c2'), t('pricing.c3')];
---

<BaseLayout
  locale={locale}
  title={`${t('pricing.title')}. ${t('brand.short')}`}
  description={t('pricing.intro')}
>
  <section
    class="reveal bg-[radial-gradient(60%_70%_at_50%_0%,var(--accent-quiet),transparent_70%),var(--surface)]"
  >
    <Container class="py-12 text-center lg:py-16">
      <p
        class="inline-block rounded-full border border-steel bg-surface-raised px-[0.9rem] py-[0.3rem] text-[0.8125rem] font-medium text-accent"
      >
        {t('pr.eyebrow')}
      </p>
      <h1 class="mt-4 text-3xl font-semibold md:text-4xl lg:text-[2.7rem]">{t('pr.title')}</h1>
      <p class="mx-auto mt-4 max-w-[58ch] text-lg text-ink-2">{t('pricing.intro')}</p>
    </Container>
  </section>

  <section aria-labelledby="noi-bat" class="reveal border-t border-steel">
    <Container wide class="py-12 lg:py-16">
      <h2 id="noi-bat" class="text-[1.375rem] font-semibold">{t('pr.featured')}</h2>

      <ul class="mt-8 grid gap-4 py-3 sm:grid-cols-2 xl:grid-cols-4">
        {
          FEATURED.map(({ key, unit, points }, i) => {
            const s = byKey[key];
            return s ? (
              <li>
                <article
                  class:list={[
                    'group relative flex h-full flex-col rounded-lg border border-steel bg-surface-raised p-6 transition-[border-color,box-shadow,translate] duration-300 ease-[var(--ease-out)] hover:-translate-y-[3px] hover:border-accent hover:shadow-[0_20px_36px_-26px_color-mix(in_srgb,var(--accent)_60%,transparent)]',
                    // Thẻ đầu là dịch vụ trọng tâm. Phân biệt bằng độ đậm của MỘT màu,
                    // không phải bằng bốn màu khác nhau như mẫu tham khảo.
                    i === 0 && 'border-accent shadow-[0_0_0_1px_var(--accent)_inset]',
                  ]}
                >
                  {i === 0 && (
                    <span class="absolute -top-[0.7rem] left-5 rounded-full bg-accent px-[0.7rem] py-[0.2rem] text-[0.6875rem] font-semibold whitespace-nowrap text-accent-contrast">
                      {clinic.tagline}
                    </span>
                  )}

                  <h3 class="text-lg font-semibold">{s.data.title}</h3>
                  <p class="mt-[0.35rem] text-[0.8125rem] leading-normal text-ink-2">{`${s.data.description.split('.')[0]}.`}</p>

                  <p class="mt-5 flex items-baseline gap-1 text-accent">
                    <span class="text-[1.65rem] leading-[1.1] font-bold measure">
                      {fmt.format(s.data.priceFrom ?? 0)}
                    </span>
                    <span class="text-[0.9375rem] font-semibold">đ</span>
                  </p>
                  <p class="mt-[0.15rem] text-xs text-ink-3">{unit}</p>

                  <ul class="[&_svg]:text-secondary mt-5 grid gap-[0.55rem] border-t border-steel pt-5 [&_svg]:mt-[0.15rem] [&>li]:flex [&>li]:gap-2 [&>li]:text-[0.8125rem] [&>li]:leading-[1.45] [&>li]:text-ink-2">
                    {points.map((pt) => (
                      <li>
                        <Icon name="ph:check-circle" class="size-4 shrink-0" aria-hidden="true" />
                        <span>{pt}</span>
                      </li>
                    ))}
                  </ul>

                  <a
                    href={pathFor(`service:${key as ServiceKey}`, locale)}
                    class="mt-auto flex min-h-11 items-center justify-center gap-[0.45rem] pt-5 text-sm font-medium text-accent transition-[gap] duration-250 ease-[var(--ease-out)] group-hover:gap-3"
                  >
                    {t('nav.services')}
                    <Icon name="ph:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
                  </a>
                </article>
              </li>
            ) : null;
          })
        }
      </ul>
    </Container>
  </section>

  <section aria-labelledby="khac" class="reveal border-t border-steel bg-surface-sunken">
    <Container wide class="py-12 lg:py-16">
      <h2 id="khac" class="text-[1.375rem] font-semibold">{t('pr.others')}</h2>

      <div class="mt-8 grid gap-8 lg:grid-cols-[1.35fr_1fr] lg:gap-10">
        <ul class="grid gap-2 sm:grid-cols-2 [&>li]:min-w-0">
          {
            others.map((s) => (
              <li>
                <a
                  href={pathFor(`service:${s.data.key as ServiceKey}`, locale)}
                  class="flex h-full min-w-0 items-center gap-[0.85rem] rounded-md border border-steel bg-surface-raised px-4 py-[0.9rem] transition-[border-color,background-color] duration-250 ease-[var(--ease-out)] hover:border-accent hover:bg-accent-quiet"
                >
                  <span class="min-w-0">
                    <span class="block font-medium">{s.data.title}</span>
                    <span class="block truncate text-xs leading-[1.4] text-ink-3">{`${s.data.description.split('.')[0]}.`}</span>
                  </span>
                  <span class="ms-auto flex-none font-semibold measure whitespace-nowrap text-accent">
                    {fmt.format(s.data.priceFrom ?? 0)}{' '}
                    <span class="text-[0.8125rem] font-medium">đ</span>
                  </span>
                  <Icon
                    name="ph:caret-right"
                    class="size-4 flex-none text-ink-3"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ul>

        {
          /*
          Khối cam kết. Ba dòng này là cam kết THẬT về cách báo giá, không phải
          lời hứa về vật liệu hay thời hạn bảo hành mà tôi không được bịa.
        */
        }
        <aside
          class="rounded-lg border border-steel bg-[radial-gradient(90%_60%_at_100%_0%,var(--accent-quiet),transparent_62%),var(--surface-raised)] p-6"
        >
          <span
            class="flex size-11 items-center justify-center rounded-md bg-accent text-accent-contrast"
          >
            <Icon name="ph:shield-check" class="size-6" aria-hidden="true" />
          </span>
          <h2 class="mt-4 text-lg font-semibold">{t('pricing.commitment')}</h2>
          <ul
            class="mt-4 grid gap-[0.7rem] [&>li]:flex [&>li]:gap-[0.6rem] [&>li]:text-sm [&>li]:leading-normal [&>li]:text-ink-2"
          >
            {
              commitments.map((c) => (
                <li>
                  <Icon
                    name="ph:check"
                    class="text-success mt-0.5 size-4 shrink-0"
                    aria-hidden="true"
                  />
                  <span>{c}</span>
                </li>
              ))
            }
          </ul>
          <ActionBar locale={locale} class="mt-6 flex-col items-stretch [&>a]:justify-center" />
        </aside>
      </div>
    </Container>
  </section>

  <section class="reveal border-t border-steel">
    <Container wide class="py-10 lg:py-12">
      <div
        class="flex flex-wrap items-start gap-4 rounded-lg border border-steel bg-surface-raised p-5"
      >
        <Icon name="ph:info" class="mt-0.5 size-5 shrink-0 text-accent" aria-hidden="true" />
        <div class="min-w-0 flex-1">
          <p class="font-semibold">{t('pr.noteTitle')}</p>
          <p class="mt-1 max-w-[70ch] text-sm text-ink-2">{t('pr.noteBody')}</p>
        </div>
        <a
          href={telHref(clinic.phone)}
          class="inline-flex min-h-11 items-center gap-[0.6rem] rounded-full bg-accent px-5 text-accent-contrast transition-colors duration-250 ease-[var(--ease-out)] hover:bg-accent-hover active:translate-y-px"
        >
          <Icon name="ph:phone-call" class="size-5 shrink-0" aria-hidden="true" />
          <span class="font-medium measure">{clinic.phone}</span>
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
