---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Container from '../components/Container.astro';
import DoctorPortrait from '../components/DoctorPortrait.astro';
import { clinic } from '../data/clinic';
import { LOCALES, type Locale } from '../i18n/locales';
import { pathFor, postPath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { getPosts } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
  post: CollectionEntry<'posts'>;
}

const { locale, post } = Astro.props;
const t = useTranslations(locale);

const { Content, headings } = await render(post);

/**
 * Cặp đường dẫn hai ngôn ngữ, tra theo `key` chứ không theo slug — hai bản dịch
 * có slug khác nhau hoàn toàn. Không truyền cái này thì alternateLinks() không
 * nhận ra đường dẫn bài viết và lùi về trang chủ, tức là đang đọc dở một bài mà
 * bấm đổi ngôn ngữ sẽ văng về đầu site.
 */
const siblings = await getCollection('posts', (e) => e.data.key === post.data.key);
const alternates = LOCALES.map((l) => {
  const match = siblings.find((s) => s.data.lang === l);
  return { locale: l, path: match ? postPath(match.data.slug, l) : pathFor('blog', l) };
});

/** Bác sĩ duyệt nội dung. getPosts() đã chặn build nếu key này không tồn tại. */
const reviewer = (await getCollection('doctors', (e) => e.data.lang === locale)).find(
  (d) => d.data.key === post.data.reviewedBy,
);

/** Mục lục chỉ đáng hiện khi bài đủ dài để người ta lạc. Dưới bốn mục thì không. */
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length > 3;

const dateFmt = new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/** Bài cùng ngôn ngữ, bỏ chính nó, lấy hai bài mới nhất. */
const more = (await getPosts(locale)).filter((p) => p.data.key !== post.data.key).slice(0, 2);
---

<BaseLayout
  locale={locale}
  title={`${post.data.title}. ${t('brand.short')}`}
  description={post.data.description}
  alternates={alternates}
  post={post}
  reviewer={reviewer}
>
  <Container class="py-10 lg:py-14">
    <a
      href={pathFor('blog', locale)}
      class="inline-flex link-slide items-center gap-1.5 text-sm text-ink-2"
    >
      <Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
      {t('blog.back')}
    </a>

    <article class="mt-8">
      <header class="max-w-[68ch]">
        <h1 class="text-3xl font-semibold text-balance md:text-4xl">{post.data.title}</h1>
        <p class="mt-4 text-lg text-ink-2">{post.data.description}</p>

        <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-sm measure text-ink-3">
          <span>
            {t('blog.published')}
            <time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>
              {dateFmt.format(post.data.publishedAt)}
            </time>
          </span>
          {
            post.data.updatedAt && (
              <span>
                {t('blog.updated')}
                <time datetime={post.data.updatedAt.toISOString().slice(0, 10)}>
                  {dateFmt.format(post.data.updatedAt)}
                </time>
              </span>
            )
          }
        </p>
      </header>

      {
        showToc && (
          <nav aria-labelledby="muc-luc" class="mt-8 max-w-[68ch] border-y border-steel py-5">
            <h2 id="muc-luc" class="text-sm font-semibold">
              {t('blog.toc')}
            </h2>
            <ol class="mt-3 space-y-1.5 text-ink-2">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="link-slide">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      {
        /*
        Kiểu chữ cho thân bài đặt ở đây chứ không nằm trong markdown: file .md
        của chủ phòng khám chỉ nên chứa nội dung, không chứa class.
      */
      }
      <div
        class:list={[
          'mt-10 max-w-[68ch] leading-relaxed text-ink-2',
          '[&>h2]:mt-12 [&>h2]:scroll-mt-24 [&>h2]:text-2xl [&>h2]:font-semibold [&>h2]:text-ink',
          '[&>h3]:mt-8 [&>h3]:text-lg [&>h3]:font-semibold [&>h3]:text-ink',
          '[&>p]:mt-4',
          '[&>ul]:mt-4 [&>ul]:space-y-2 [&>ul]:ps-5 [&>ul>li]:list-disc',
          '[&>ol]:mt-4 [&>ol]:space-y-2 [&>ol]:ps-5 [&>ol>li]:list-decimal',
          '[&>blockquote]:mt-6 [&>blockquote]:border-s-2 [&>blockquote]:border-accent',
          '[&>blockquote]:ps-5 [&>blockquote]:text-ink',
          '[&_strong]:font-semibold [&_strong]:text-ink',
          '[&_a]:link-slide [&_a]:text-accent',
        ]}
      >
        <Content />
      </div>

      {
        reviewer && (
          <aside class="mt-14 flex max-w-[68ch] gap-5 border-t border-steel pt-6">
            <DoctorPortrait
              portrait={reviewer.data.portrait}
              name={reviewer.data.name}
              class="w-20 shrink-0"
            />
            <div>
              <p class="text-sm text-ink-3">{t('blog.reviewedBy')}</p>
              <p class="mt-1 font-semibold">{reviewer.data.name}</p>
              <p class="text-sm text-ink-2">{reviewer.data.title}</p>
              <a
                href={pathFor('about', locale)}
                class="mt-2 inline-flex link-slide items-center gap-1 text-sm text-ink-2"
              >
                {locale === 'vi' ? 'Xem hồ sơ' : 'View profile'}
                <Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
              </a>
            </div>
          </aside>
        )
      }
    </article>

    {
      more.length > 0 && (
        <section aria-labelledby="doc-them" class="mt-16 border-t border-steel pt-8">
          <h2 id="doc-them" class="text-lg font-semibold">
            {locale === 'vi' ? 'Đọc thêm' : 'Read next'}
          </h2>
          <ul class="mt-4 divide-y divide-steel">
            {more.map((p) => (
              <li>
                <a href={postPath(p.data.slug, locale)} class="group block py-4">
                  <h3 class="font-semibold transition-colors duration-300 group-hover:text-accent">
                    {p.data.title}
                  </h3>
                  <p class="mt-1 max-w-[62ch] text-sm text-ink-2">{p.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="mt-14 max-w-[68ch] border-t border-steel pt-6 text-sm text-ink-3">
      {
        locale === 'vi'
          ? `Bài viết mang tính thông tin chung, không thay thế cho việc khám trực tiếp. Gọi ${clinic.phone} để đặt lịch khám.`
          : `This article is general information and does not replace an examination. Call ${clinic.phone} to book an appointment.`
      }
    </p>
  </Container>
</BaseLayout>
