---
import { Icon } from 'astro-icon/components';
import Container from '../components/Container.astro';
import type { Locale } from '../i18n/locales';
import { postPath } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import { getPosts } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = await getPosts(locale);

/**
 * Nhóm theo năm. Mới nhất trước — getPosts đã sắp sẵn nên chỉ cần gom, không
 * sắp lại. Map giữ nguyên thứ tự chèn nên năm cũng ra đúng thứ tự đó.
 */
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.publishedAt.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}

const dateFmt = new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', {
  day: 'numeric',
  month: 'long',
});
---

<BaseLayout
  locale={locale}
  title={`${t('blog.title')}. ${t('brand.short')}`}
  description={t('blog.intro')}
>
  <Container class="py-12 lg:py-16">
    <h1 class="text-3xl font-semibold md:text-4xl lg:text-[2.75rem]">{t('blog.title')}</h1>
    <p class="mt-4 max-w-[62ch] text-lg text-ink-2">{t('blog.intro')}</p>

    {
      posts.length === 0 ? (
        <p class="mt-10 border-t border-steel pt-6 text-ink-2">{t('blog.pending')}</p>
      ) : (
        <div class="mt-12 space-y-12">
          {[...byYear].map(([year, items]) => (
            <section aria-labelledby={`nam-${year}`}>
              {/*
                Năm là mốc đọc lướt, không phải tiêu đề nội dung — nên nó nhỏ và
                mờ, đứng cạnh danh sách chứ không đè lên nó.
              */}
              <h2
                id={`nam-${year}`}
                class="border-b border-steel pb-2 text-sm font-semibold measure text-ink-3"
              >
                {year}
              </h2>

              <ul class="divide-y divide-steel">
                {items.map((p) => (
                  <li>
                    <a
                      href={postPath(p.data.slug, locale)}
                      class="group grid gap-1 py-6 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6"
                    >
                      <time
                        datetime={p.data.publishedAt.toISOString().slice(0, 10)}
                        class="text-sm measure text-ink-3 sm:pt-0.5"
                      >
                        {dateFmt.format(p.data.publishedAt)}
                      </time>

                      <div>
                        <h3 class="text-lg font-semibold transition-colors duration-300 group-hover:text-accent">
                          {p.data.title}
                        </h3>
                        <p class="mt-1.5 max-w-[62ch] text-ink-2">{p.data.description}</p>
                        <span class="mt-2 inline-flex items-center gap-1 text-sm text-accent">
                          {locale === 'vi' ? 'Đọc bài' : 'Read'}
                          <Icon
                            name="ph:arrow-right"
                            class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
                            aria-hidden="true"
                          />
                        </span>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </Container>
</BaseLayout>
