---
/**
 * Khung ảnh giữ chỗ, có nhãn rõ ràng.
 *
 * Phòng khám chưa có ảnh chụp và sẽ bổ sung sau, nên site dùng khung định sẵn
 * tỷ lệ thay vì ảnh stock. Ảnh stock nha khoa trông giả và phản tác dụng với
 * mục tiêu uy tín; khung trống có nhãn thì trung thực hơn.
 *
 * Đặt `clinical` cho ảnh lâm sàng (trước/sau, cận cảnh răng): khung giữ nền sáng
 * ở cả chế độ tối để không làm răng trông trắng hơn thực tế.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** Tên slot trong shot-list, ví dụ "hero", "doctor-portrait" */
  slot: string;
  /** Tỷ lệ khung, ví dụ "3/2", "4/5", "1/1" */
  ratio: string;
  /** Mô tả cảnh cần chụp, hiện ngay trên khung để người chụp biết */
  brief: string;
  clinical?: boolean;
  class?: string;
}

const { slot, ratio, brief, clinical = false, class: className = '' } = Astro.props;
---

<figure
  class:list={[
    'flex flex-col items-center justify-center gap-3 border border-dashed p-6 text-center',
    clinical ? 'clinical-frame' : 'border-steel-edge bg-surface-sunken',
    className,
  ]}
  style={`aspect-ratio: ${ratio}`}
  data-image-slot={slot}
>
  <Icon name="ph:camera" class="size-7 opacity-40" aria-hidden="true" />
  <figcaption class="max-w-[34ch] space-y-1">
    <span class="measure block text-xs opacity-60">{slot}</span>
    <span class="measure block text-xs opacity-45">{ratio}</span>
    <span class="block text-sm opacity-75">{brief}</span>
  </figcaption>
</figure>
