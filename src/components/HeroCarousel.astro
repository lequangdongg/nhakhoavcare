---
/**
 * Carousel ba slide cho phần banner.
 *
 * Điều hướng bằng NÚT chứ không phải liên kết neo. Liên kết neo bắt trình duyệt
 * cuộn cả trang tới phần tử, gây giật; nút chỉ cuộn bên trong khung.
 *
 * Không tự chạy. Slide tự đổi khi người ta đang đọc là một trong những thứ khó
 * chịu nhất trên web, và site cũ đã mắc đúng lỗi đó với 6 slide rỗng.
 *
 * Vuốt trên mobile hoạt động sẵn vì đó là cuộn thật của trình duyệt, không phải
 * cử chỉ tự chế. Mỗi slide mang một thông tin thật, không phải ảnh trang trí.
 */
import { Icon } from 'astro-icon/components';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Sắc độ thật của bộ VITA classical, xếp từ sáng tới sẫm.
const shades = [
  { code: 'B1', v: 'var(--shade-b1)' },
  { code: 'A1', v: 'var(--shade-a1)' },
  { code: 'A2', v: 'var(--shade-a2)' },
  { code: 'B3', v: 'var(--shade-b3)' },
  { code: 'A3', v: 'var(--shade-a3)' },
  { code: 'C3', v: 'var(--shade-c3)' },
  { code: 'A4', v: 'var(--shade-a4)' },
];

const steps = [
  { icon: 'ph:scan', label: t('slide.step1') },
  { icon: 'ph:screwdriver', label: t('slide.step2') },
  { icon: 'ph:hourglass-medium', label: t('slide.step3') },
  { icon: 'ph:tooth', label: t('slide.step4') },
];

const promises = [t('pricing.c1'), t('pricing.c2'), t('pricing.c3')];
const tabs = [t('slide.shadeTab'), t('slide.processTab'), t('slide.promiseTab')];
---

<div class="carousel" data-carousel>
  <div class="track" data-track tabindex="0" role="group" aria-label={t('slide.region')}>
    {/* ── Slide 1: so màu ────────────────────────────────────────────────── */}
    <section class="slide" aria-labelledby="sl-shade" aria-roledescription="slide">
      <h2 id="sl-shade" class="slide-title">{t('slide.shadeTitle')}</h2>
      <p class="slide-body">{t('slide.shadeBody')}</p>

      {/* Dải sắc độ nằm ngang, mã hiệu dưới từng ô, đọc được rõ ràng. */}
      <ol class="shade-strip">
        {
          shades.map((s) => (
            <li>
              <span class="chip" style={`background-color: ${s.v}`} aria-hidden="true" />
              <span class="measure chip-code">{s.code}</span>
            </li>
          ))
        }
      </ol>
    </section>

    {/* ── Slide 2: quy trình Implant ─────────────────────────────────────── */}
    <section class="slide" aria-labelledby="sl-process" aria-roledescription="slide">
      <h2 id="sl-process" class="slide-title">{t('slide.processTitle')}</h2>
      <p class="slide-body">{t('slide.processBody')}</p>

      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <span class="step-icon">
                <Icon name={s.icon} class="size-5" aria-hidden="true" />
              </span>
              <span class="step-label">{s.label}</span>
            </li>
          ))
        }
      </ol>
    </section>

    {/* ── Slide 3: cam kết chi phí ───────────────────────────────────────── */}
    <section class="slide" aria-labelledby="sl-promise" aria-roledescription="slide">
      <h2 id="sl-promise" class="slide-title">{t('slide.promiseTitle')}</h2>
      <p class="slide-body">{t('slide.promiseBody')}</p>

      <ul class="promises">
        {
          promises.map((p) => (
            <li>
              <Icon
                name="ph:check-circle"
                class="size-5 shrink-0 text-success"
                aria-hidden="true"
              />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <div class="controls">
    <button type="button" class="arrow" data-prev aria-label={t('slide.prev')}>
      <Icon name="ph:arrow-left" class="size-[1.05rem]" aria-hidden="true" />
    </button>

    <div class="dots" role="tablist" aria-label={t('slide.nav')}>
      {
        tabs.map((label, i) => (
          <button
            type="button"
            class="dot"
            role="tab"
            data-dot={i}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={label}
          >
            <span class="dot-fill" />
          </button>
        ))
      }
    </div>

    <button type="button" class="arrow" data-next aria-label={t('slide.next')}>
      <Icon name="ph:arrow-right" class="size-[1.05rem]" aria-hidden="true" />
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    for (const root of document.querySelectorAll('[data-carousel]')) {
      const track = root.querySelector('[data-track]');
      const slides = [...track.children];
      const dots = [...root.querySelectorAll('[data-dot]')];
      let index = 0;

      const sync = (i) => {
        index = i;
        dots.forEach((d, n) => d.setAttribute('aria-selected', String(n === i)));
      };

      // Cuộn TRONG khung, không phải cuộn trang. Đây là điểm khác với liên kết neo.
      const go = (i) => {
        const next = Math.max(0, Math.min(slides.length - 1, i));
        track.scrollTo({ left: slides[next].offsetLeft - track.offsetLeft, behavior: 'smooth' });
        sync(next);
      };

      dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
      root.querySelector('[data-prev]').addEventListener('click', () => go(index - 1));
      root.querySelector('[data-next]').addEventListener('click', () => go(index + 1));

      // Vuốt tay hoặc cuộn ngang cũng phải cập nhật chấm cho khớp.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) sync(slides.indexOf(e.target));
          }
        },
        { root: track, threshold: 0.6 },
      );
      slides.forEach((s) => io.observe(s));

      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          go(index + 1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          go(index - 1);
        }
      });
    }
  })();
</script>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--r-lg);
  }
  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 21rem;
    padding: 1.75rem;
    border: 1px solid var(--steel-line);
    border-radius: var(--r-lg);
    background: var(--surface-raised);
    box-shadow: 0 20px 40px -30px rgb(31 41 55 / 0.4);
  }

  .slide-title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .slide-body {
    max-width: 46ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* ── Dải sắc độ ─────────────────────────────────────────────────────── */
  .shade-strip {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.375rem;
    margin-top: auto;
  }
  .shade-strip li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: center;
  }
  .chip {
    display: block;
    width: 100%;
    height: clamp(4rem, 9vw, 5.5rem);
    border: 1px solid rgb(31 41 55 / 0.12);
    border-radius: 0.2rem 0.2rem var(--r-sm) var(--r-sm);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.5) inset,
      0 6px 12px -8px rgb(31 41 55 / 0.35);
    transition: transform 0.3s var(--ease-out);
  }
  .shade-strip li:hover .chip {
    transform: translateY(-5px);
  }
  .chip-code {
    font-size: 0.6875rem;
    color: var(--text-tertiary);
  }

  /* ── Quy trình ──────────────────────────────────────────────────────── */
  .steps {
    display: grid;
    gap: 0.5rem;
    margin-top: auto;
  }
  .steps li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: var(--r-md);
    background: var(--surface-sunken);
  }
  .step-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-md);
    background: var(--secondary-quiet);
    color: var(--secondary);
  }
  .step-label {
    font-size: 0.9375rem;
  }

  /* ── Cam kết ────────────────────────────────────────────────────────── */
  .promises {
    display: grid;
    gap: 0.875rem;
    margin-top: auto;
  }
  .promises li {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* ── Điều khiển ─────────────────────────────────────────────────────── */
  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .arrow {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--steel-edge);
    border-radius: var(--r-pill);
    background: var(--surface-raised);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out);
  }
  .arrow:hover {
    border-color: var(--accent);
    background: var(--accent-quiet);
    color: var(--accent);
  }
  .arrow:active {
    translate: 0 1px;
  }

  .dots {
    display: flex;
    flex: 1;
    justify-content: center;
    gap: 0.5rem;
  }

  /* Chấm đang chọn kéo dài thành thanh. Hình dạng cho biết đang ở slide nào
     mà không cần thêm chữ. */
  .dot {
    height: 0.5rem;
    width: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--steel-edge);
    cursor: pointer;
    transition:
      width 0.35s var(--ease-out),
      background-color 0.25s var(--ease-out);
  }
  .dot:hover {
    background: var(--text-tertiary);
  }
  .dot[aria-selected='true'] {
    width: 1.75rem;
    background: var(--accent);
  }
  .dot-fill {
    display: block;
  }
</style>
