---
/**
 * Bộ chọn giao diện: bảng màu, bố cục, nền sáng tối.
 *
 * Mở đóng bằng <details> nên không tốn JavaScript cho phần đó. JavaScript chỉ
 * làm đúng ba việc: ghi lựa chọn, đặt thuộc tính lên <html>, và đọc lại trạng
 * thái mỗi lần mở bảng.
 *
 * Đọc lại mỗi lần mở là điểm quan trọng: nền sáng tối còn đổi được từ hộp thoại
 * tìm kiếm nữa. Hai bảng không nhắn tin cho nhau, chúng cùng nhìn vào <html> —
 * một nguồn sự thật duy nhất, nên không bao giờ lệch nhau.
 *
 * Ô xem trước lấy màu từ SKIN_SWATCH trong appearance.ts. Test giữ cho các giá
 * trị đó khớp với appearance.css.
 */
import { Icon } from 'astro-icon/components';
import type { Locale } from '../i18n/locales';
import {
  LAYOUTS,
  LAYOUT_LABEL,
  LAYOUT_STORAGE_KEY,
  SKINS,
  SKIN_LABEL,
  SKIN_STORAGE_KEY,
  SKIN_SWATCH,
  THEME_PREFERENCES,
  THEME_STORAGE_KEY,
} from '../lib/appearance';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const modeIcon = { system: 'ph:desktop', light: 'ph:sun', dark: 'ph:moon' } as const;

// Sơ đồ bố cục vẽ bằng ô CSS, không phải ảnh: nó phải đổi màu theo theme đang
// chọn, mà ảnh thì không làm được điều đó.
/**
 * Sơ đồ bố cục vẽ bằng thanh, mỗi loại thanh là một chuỗi lớp Tailwind.
 *
 * Dùng bg-current chứ không phải màu cố định: thanh phải đổi màu theo bảng màu
 * đang chọn và theo trạng thái đang bấm, mà ảnh thì không làm được điều đó.
 * Biến thể [[aria-pressed=true]_&] có độ ưu tiên cao hơn opacity nền nên nó
 * thắng, không phụ thuộc thứ tự lớp.
 */
const BAR =
  'rounded-[2px] bg-current [[aria-pressed=true]_&]:text-accent [[aria-pressed=true]_&]:opacity-100';

const BAR_KIND = {
  full: 'h-2 w-full opacity-30',
  half: 'h-2 w-[calc(50%-0.125rem)] opacity-30',
  // Thanh đặc là khối hình, thanh nhạt là chữ. Nhờ vậy đảo cột nhìn ra ngay là
  // đảo chứ không trùng với hai cột.
  'half-solid': 'h-2 w-[calc(50%-0.125rem)] opacity-60',
  short: 'h-2 w-3/5 opacity-30',
  narrow: 'mx-auto h-2 w-[70%] opacity-30',
  thin: 'h-1 w-full opacity-30',
  'full-tall': 'h-[1.125rem] w-full opacity-30',
  'wide-tall': 'h-3.5 w-full opacity-30',
  // Viền rỗng: khối là một cái thẻ nổi chứ không phải một mảng đặc.
  box: 'h-3.5 w-full border-[1.5px] border-current bg-transparent opacity-40',
  'block-tall': 'h-6 w-full opacity-30',
  'outline-full': 'h-2 w-full border border-current bg-transparent opacity-40',
  pill: 'mx-auto h-1.5 w-4/5 rounded-full opacity-50',
  // Nhạt hơn hẳn, dùng để vẽ nhịp nền xen kẽ
  'full-dim': 'h-2 w-full opacity-15',
  // Tràn ra ngoài khung sơ đồ, đúng cái mà bố cục tràn mép làm với trang
  'edge-full': '-mx-[6%] h-2 w-[112%] opacity-30',
  'type-lg': 'h-3 w-4/5 opacity-40',
} as const;

const layoutBars: Record<(typeof LAYOUTS)[number], Array<keyof typeof BAR_KIND>> = {
  split: ['half', 'half-solid', 'full'],
  mirror: ['half-solid', 'half', 'full'],
  stage: ['full', 'full-tall'],
  showcase: ['full-tall', 'full', 'short'],
  overlay: ['full-tall', 'narrow'],
  sticky: ['half', 'half-solid', 'half'],
  full: ['block-tall'],
  banner: ['thin', 'full', 'full', 'full'],
  frame: ['outline-full', 'full', 'full'],
  rail: ['pill', 'full', 'full'],
  slim: ['thin', 'half', 'half'],
  list: ['short', 'full', 'full'],
  mapfirst: ['short', 'wide-tall'],
  proof: ['short', 'wide-tall', 'full'],
  servicefirst: ['short', 'full', 'half', 'half'],
  compact: ['thin', 'thin', 'thin', 'thin', 'thin'],
  wide: ['wide-tall', 'wide-tall'],
  bigtype: ['type-lg', 'type-lg', 'full'],
  magazine: ['full-tall', 'half', 'half'],
  zebra: ['full', 'full-dim', 'full', 'full-dim'],
  card: ['box', 'box'],
  paper: ['full', 'narrow', 'narrow'],
  edge: ['edge-full', 'edge-full', 'edge-full'],
  stack: ['narrow', 'narrow', 'narrow'],
};
---

<details class="appearance group/ap relative">
  <summary
    class="flex size-9 cursor-pointer list-none items-center justify-center rounded-full border border-steel-edge transition-colors duration-300 hover:border-accent hover:bg-accent-quiet hover:text-accent"
    aria-label={t('appearance.open')}
    title={t('appearance.open')}
  >
    <Icon name="ph:palette" class="size-[1.15rem]" aria-hidden="true" />
  </summary>

  <div
    class="absolute end-0 top-[calc(100%+0.625rem)] z-50 w-[min(23rem,calc(100vw-1.5rem))] rounded-lg border border-steel bg-surface-raised p-4 shadow-xl shadow-ink/10 [[open]>&]:animate-menu-in motion-reduce:[[open]>&]:animate-none"
  >
    {/* ── Bảng màu ──────────────────────────────────────────────────── */}
    <p class="text-xs font-semibold text-ink-3">{t('appearance.skin')}</p>
    <div class="mt-2 grid grid-cols-3 gap-2" role="group" aria-label={t('appearance.skin')}>
      {
        SKINS.map((skin) => (
          <button
            type="button"
            data-skin-set={skin}
            aria-pressed="false"
            class="ap-opt flex flex-col items-center gap-2 rounded-md border border-steel p-2.5 transition-[border-color,background-color] duration-250 ease-[var(--ease-out)] hover:border-accent hover:bg-accent-quiet aria-pressed:border-accent aria-pressed:bg-accent-quiet"
          >
            <span
              class="flex h-7 w-full overflow-hidden rounded-sm ring-1 ring-steel-edge"
              aria-hidden="true"
            >
              <span class="w-1/2" style={`background:${SKIN_SWATCH[skin].surface}`} />
              <span class="w-1/4" style={`background:${SKIN_SWATCH[skin].accent}`} />
              <span class="w-1/4" style={`background:${SKIN_SWATCH[skin].secondary}`} />
            </span>
            <span class="text-[0.6875rem] leading-tight font-medium">{t(SKIN_LABEL[skin])}</span>
          </button>
        ))
      }
    </div>

    {/* ── Bố cục ────────────────────────────────────────────────────── */}
    <p class="mt-4 text-xs font-semibold text-ink-3">{t('appearance.layout')}</p>
    <div
      class="mt-2 grid max-h-72 grid-cols-3 gap-2 overflow-y-auto pe-1"
      role="group"
      aria-label={t('appearance.layout')}
    >
      {
        LAYOUTS.map((layout) => (
          <button
            type="button"
            data-layout-set={layout}
            aria-pressed="false"
            class="ap-opt flex flex-col items-center gap-2 rounded-md border border-steel p-2.5 transition-[border-color,background-color] duration-250 ease-[var(--ease-out)] hover:border-accent hover:bg-accent-quiet aria-pressed:border-accent aria-pressed:bg-accent-quiet"
          >
            <span class="flex h-7 w-full flex-wrap content-start gap-0.5" aria-hidden="true">
              {layoutBars[layout].map((kind) => (
                <span class={`${BAR} ${BAR_KIND[kind]}`} />
              ))}
            </span>
            <span class="text-[0.6875rem] leading-tight font-medium">
              {t(LAYOUT_LABEL[layout])}
            </span>
          </button>
        ))
      }
    </div>

    {/* ── Nền ───────────────────────────────────────────────────────── */}
    <p class="mt-4 text-xs font-semibold text-ink-3">{t('theme.label')}</p>
    <div class="mt-2 grid grid-cols-3 gap-2" role="group" aria-label={t('theme.label')}>
      {
        THEME_PREFERENCES.map((mode) => (
          <button
            type="button"
            data-mode-set={mode}
            aria-pressed="false"
            class="ap-opt flex min-h-10 items-center justify-center gap-1.5 rounded-md border border-steel px-2 text-[0.6875rem] font-medium transition-[border-color,background-color] duration-250 ease-[var(--ease-out)] hover:border-accent hover:bg-accent-quiet aria-pressed:border-accent aria-pressed:bg-accent-quiet"
          >
            <Icon name={modeIcon[mode]} class="size-4 shrink-0" aria-hidden="true" />
            {t(`theme.${mode}`)}
          </button>
        ))
      }
    </div>

    <button
      type="button"
      data-appearance-reset
      class="mt-4 flex min-h-10 w-full items-center justify-center gap-1.5 rounded-full border border-steel text-[0.8125rem] transition-colors duration-250 ease-[var(--ease-out)] hover:border-accent hover:text-accent active:translate-y-px"
    >
      <Icon name="ph:arrow-counter-clockwise" class="size-4 shrink-0" aria-hidden="true" />
      {t('appearance.reset')}
    </button>
  </div>
</details>

<script
  is:inline
  define:vars={{
    skinKey: SKIN_STORAGE_KEY,
    layoutKey: LAYOUT_STORAGE_KEY,
    themeKey: THEME_STORAGE_KEY,
  }}
>
  (() => {
    const box = document.querySelector('.appearance');
    if (!box) return;
    const root = document.documentElement;

    // Đọc trạng thái từ <html> chứ không giữ biến riêng. Nền sáng tối còn đổi
    // được ở hộp thoại tìm kiếm, giữ bản sao riêng là mời lỗi lệch trạng thái.
    const refresh = () => {
      const mode = localStorage.getItem(themeKey) ?? 'system';
      for (const b of box.querySelectorAll('[data-skin-set]'))
        b.setAttribute('aria-pressed', String(b.dataset.skinSet === root.dataset.theme));
      for (const b of box.querySelectorAll('[data-layout-set]'))
        b.setAttribute('aria-pressed', String(b.dataset.layoutSet === root.dataset.layout));
      for (const b of box.querySelectorAll('[data-mode-set]'))
        b.setAttribute('aria-pressed', String(b.dataset.modeSet === mode));
    };

    const save = (key, value) => {
      try {
        if (value === null) localStorage.removeItem(key);
        else localStorage.setItem(key, value);
      } catch {
        /* chế độ riêng tư chặn ghi: lựa chọn vẫn áp cho phiên này, chỉ không nhớ */
      }
    };

    const applyMode = (mode) => {
      const dark =
        mode === 'dark' || (mode !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
      root.classList.toggle('dark', dark);
    };

    for (const b of box.querySelectorAll('[data-skin-set]'))
      b.addEventListener('click', () => {
        root.dataset.theme = b.dataset.skinSet;
        save(skinKey, b.dataset.skinSet);
        refresh();
      });

    for (const b of box.querySelectorAll('[data-layout-set]'))
      b.addEventListener('click', () => {
        root.dataset.layout = b.dataset.layoutSet;
        save(layoutKey, b.dataset.layoutSet);
        refresh();
      });

    for (const b of box.querySelectorAll('[data-mode-set]'))
      b.addEventListener('click', () => {
        const mode = b.dataset.modeSet;
        applyMode(mode);
        save(themeKey, mode === 'system' ? null : mode);
        refresh();
      });

    box.querySelector('[data-appearance-reset]')?.addEventListener('click', () => {
      root.dataset.theme = 'clinical';
      root.dataset.layout = 'split';
      save(skinKey, null);
      save(layoutKey, null);
      save(themeKey, null);
      applyMode('system');
      refresh();
    });

    box.addEventListener('toggle', () => box.open && refresh());
    document.addEventListener('click', (e) => {
      if (box.open && !box.contains(e.target)) box.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && box.open) box.open = false;
    });

    refresh();
  })();
</script>
