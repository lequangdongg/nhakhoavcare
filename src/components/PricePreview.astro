---
/**
 * Xem trước bảng giá trên trang chủ.
 *
 * Dùng ĐÚNG kiểu hàng của trang bảng giá, để hai nơi đọc ra là một hệ chứ không
 * phải hai thiết kế rời. Bản trước dùng đường kẻ chấm kiểu thực đơn, vừa lệch
 * với trang giá vừa có lỗi: kẻ chấm kéo dài bằng -100vw nên tràn ra khỏi khung
 * chứa, chạy hết chiều ngang màn hình.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import type { Locale } from '../i18n/locales';
import { type ServiceKey, pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  limit?: number;
}

const { locale, limit = 6 } = Astro.props;
const t = useTranslations(locale);

const services = (await getCollection('services', (e) => e.data.lang === locale))
  .filter((s) => s.data.priceFrom !== undefined)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, limit);

const fmt = new Intl.NumberFormat(locale === 'vi' ? 'vi-VN' : 'en-US');
---

{
  /* min-w-0 ở cả ô lưới và hàng: ô lưới mặc định min-width:auto nên không co
    dưới kích thước nội dung, khiến chuỗi nowrap bên trong làm tràn ngang mobile. */
}
<ul class="grid gap-2 md:grid-cols-2 [&>li]:min-w-0">
  {
    services.map((s) => (
      <li>
        <a
          href={pathFor(`service:${s.data.key as ServiceKey}`, locale)}
          class="group flex h-full min-w-0 items-center gap-[0.85rem] rounded-md border border-steel bg-surface-raised px-4 py-[0.9rem] transition-[border-color,background-color,translate] duration-250 ease-[var(--ease-out)] hover:-translate-y-0.5 hover:border-accent hover:bg-accent-quiet focus-visible:-translate-y-0.5 focus-visible:border-accent focus-visible:bg-accent-quiet"
        >
          <span class="min-w-0">
            <span class="block font-medium transition-colors duration-250 ease-[var(--ease-out)] group-hover:text-accent">
              {s.data.title}
            </span>
            <span class="block truncate text-xs leading-[1.4] text-ink-3">{`${s.data.description.split('.')[0]}.`}</span>
          </span>

          <span class="ms-auto flex flex-none items-baseline gap-1 whitespace-nowrap">
            <span class="text-xs text-ink-3">{t('home.priceFrom')}</span>
            <span class="text-[1.0625rem] font-semibold measure text-accent">
              {fmt.format(s.data.priceFrom!)}
            </span>
            <span class="text-[0.8125rem] font-medium text-accent">đ</span>
          </span>

          <Icon
            name="ph:caret-right"
            class="size-4 flex-none text-ink-3 transition-[color,translate] duration-250 ease-[var(--ease-out)] group-hover:translate-x-0.5 group-hover:text-accent"
            aria-hidden="true"
          />
        </a>
      </li>
    ))
  }
</ul>
