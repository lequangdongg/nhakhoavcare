---
/**
 * Xem trước bảng giá trên trang chủ.
 *
 * Dùng ĐÚNG kiểu hàng của trang bảng giá, để hai nơi đọc ra là một hệ chứ không
 * phải hai thiết kế rời. Bản trước dùng đường kẻ chấm kiểu thực đơn, vừa lệch
 * với trang giá vừa có lỗi: kẻ chấm kéo dài bằng -100vw nên tràn ra khỏi khung
 * chứa, chạy hết chiều ngang màn hình.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import type { Locale } from '../i18n/locales';
import { type ServiceKey, pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  limit?: number;
}

const { locale, limit = 6 } = Astro.props;
const t = useTranslations(locale);

const services = (await getCollection('services', (e) => e.data.lang === locale))
  .filter((s) => s.data.priceFrom !== undefined)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, limit);

const fmt = new Intl.NumberFormat(locale === 'vi' ? 'vi-VN' : 'en-US');
---

<ul class="prows">
  {
    services.map((s) => (
      <li>
        <a href={pathFor(`service:${s.data.key as ServiceKey}`, locale)} class="prow">
          <span class="min-w-0">
            <span class="prow-name">{s.data.title}</span>
            <span class="prow-sub">{`${s.data.description.split('.')[0]}.`}</span>
          </span>

          <span class="prow-price">
            <span class="prow-label">{t('home.priceFrom')}</span>
            <span class="measure prow-num">{fmt.format(s.data.priceFrom!)}</span>
            <span class="prow-cur">đ</span>
          </span>

          <Icon name="ph:caret-right" class="prow-arrow size-4 shrink-0" aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .prows {
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 768px) {
    .prows {
      grid-template-columns: 1fr 1fr;
    }
  }

  .prow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--steel-line);
    border-radius: var(--r-md);
    background: var(--surface-raised);
    transition:
      border-color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      translate 0.25s var(--ease-out);
  }
  .prow:hover,
  .prow:focus-visible {
    border-color: var(--accent);
    background: var(--accent-quiet);
    translate: 0 -2px;
  }

  .prow-name {
    display: block;
    font-weight: 500;
    transition: color 0.25s var(--ease-out);
  }
  .prow:hover .prow-name {
    color: var(--accent);
  }

  .prow-sub {
    display: block;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--text-tertiary);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .prow-price {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    margin-inline-start: auto;
    white-space: nowrap;
  }
  .prow-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }
  .prow-num {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--accent);
  }
  .prow-cur {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
  }

  .prow-arrow {
    color: var(--text-tertiary);
    transition:
      color 0.25s var(--ease-out),
      translate 0.25s var(--ease-out);
  }
  .prow:hover .prow-arrow {
    color: var(--accent);
    translate: 2px 0;
  }
</style>
