---
/**
 * Mục điều hướng có bảng con, mở khi rê chuột.
 *
 * Nhãn là <button> chứ không phải liên kết: mục có menu con thì không tự đi đâu
 * cả, người dùng chọn mục con hoặc bấm dòng "xem tất cả" ở cuối bảng.
 *
 * Không dùng JavaScript. Bảng hiện bằng group-hover cho chuột và
 * group-focus-within cho bàn phím lẫn thiết bị chạm, vì chạm vào nút là nút nhận
 * focus. Có dải đệm vô hình (pt-2.5) giữa nút và bảng để chuột đi xuống không
 * làm bảng tắt giữa chừng.
 *
 * Toàn bộ kiểu viết bằng utility của Tailwind, không có khối <style> riêng.
 * Trạng thái "đang ở trang này" dùng thuộc tính data-active chứ không phải lớp:
 * biến thể data-[active] có độ ưu tiên cao hơn lớp nền nên chắc chắn thắng, còn
 * hai lớp cùng loại thì thứ tự trong file CSS quyết định, không phải thứ tự viết.
 */
import { Icon } from 'astro-icon/components';

export interface DropdownItem {
  href: string;
  title: string;
  description: string;
  icon: string;
}

interface Props {
  label: string;
  items: DropdownItem[];
  /** Trang tổng, đặt ở dòng cuối bảng */
  allHref: string;
  allLabel: string;
  active?: boolean;
}

const { label, items, allHref, allLabel, active = false } = Astro.props;
---

<div class="group relative">
  <button
    type="button"
    aria-expanded="false"
    data-navitem
    data-active={active ? 'true' : undefined}
    class:list={[
      'relative z-10 flex cursor-pointer items-center gap-1.5 px-3 py-2 text-[0.9375rem] transition-colors duration-300 hover:text-ink',
      // Gạch chân: trượt ngang ra từ giữa khi rê hoặc khi đang ở trang đó.
      "after:absolute after:inset-x-3 after:bottom-0.5 after:h-0.5 after:scale-x-0 after:rounded-full after:bg-accent after:transition-transform after:duration-300 after:ease-[var(--ease-out)] after:content-[''] group-focus-within:after:scale-x-100 hover:after:scale-x-100 data-[active]:after:scale-x-100",
      active ? 'text-ink' : 'text-ink-2',
    ]}
  >
    {label}
    <Icon
      name="ph:caret-down"
      class="size-3.5 transition-transform duration-300 ease-[var(--ease-out)] group-focus-within:rotate-180 group-hover:rotate-180"
      aria-hidden="true"
    />
  </button>

  {
    /* Bảng trượt xuống nhẹ khi hiện. Chuyển động có lý do: nó cho biết bảng thuộc
      về mục đang rê chứ không phải nổi lên từ đâu đó. */
  }
  <div
    class="invisible absolute top-full left-1/2 z-50 -translate-x-1/2 translate-y-[-6px] pt-2.5 opacity-0 transition-[opacity,visibility,translate] duration-200 ease-[var(--ease-out)] group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 motion-reduce:translate-y-0"
  >
    {/* Bảng chưa mở thì không nhận chuột, tránh chắn nội dung phía dưới */}
    <div
      class="pointer-events-none w-[min(44rem,90vw)] rounded-lg border border-steel bg-surface-raised p-2 shadow-xl shadow-ink/10 group-focus-within:pointer-events-auto group-hover:pointer-events-auto"
    >
      <ul class="grid gap-0.5 sm:grid-cols-2">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                class="group/i flex gap-3 rounded-md p-3 transition-colors duration-200 hover:bg-surface-sunken focus-visible:bg-surface-sunken"
              >
                <span class="bg-secondary-quiet text-secondary mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-md">
                  <Icon name={item.icon} class="size-5" aria-hidden="true" />
                </span>
                <span class="min-w-0">
                  <span class="block text-[0.9375rem] font-medium transition-colors duration-200 group-hover/i:text-accent">
                    {item.title}
                  </span>
                  <span class="mt-0.5 block text-[0.8125rem] leading-snug text-ink-2">
                    {item.description}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href={allHref}
        class="mt-1 flex items-center justify-between gap-2 rounded-md border-t border-steel px-3 py-2.5 text-sm text-ink-2 transition-colors duration-200 hover:bg-surface-sunken hover:text-ink active:translate-y-px"
      >
        {allLabel}
        <Icon name="ph:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
      </a>
    </div>
  </div>
</div>
