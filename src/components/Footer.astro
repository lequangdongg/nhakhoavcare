---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { clinic, telHref, zaloHref } from '../data/clinic';
import type { Locale } from '../i18n/locales';
import { type ServiceKey, pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import BrandMark from './BrandMark.astro';
import Container from './Container.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

type DayKey = keyof typeof clinic.hours;

const DAY_LABELS: Record<Locale, Record<DayKey, string>> = {
  vi: {
    monday: 'Thứ Hai',
    tuesday: 'Thứ Ba',
    wednesday: 'Thứ Tư',
    thursday: 'Thứ Năm',
    friday: 'Thứ Sáu',
    saturday: 'Thứ Bảy',
    sunday: 'Chủ Nhật',
  },
  en: {
    monday: 'Monday',
    tuesday: 'Tuesday',
    wednesday: 'Wednesday',
    thursday: 'Thursday',
    friday: 'Friday',
    saturday: 'Saturday',
    sunday: 'Sunday',
  },
};

const days = Object.entries(clinic.hours) as Array<[DayKey, (typeof clinic.hours)[DayKey]]>;

// Sáu dịch vụ đầu theo thứ tự ưu tiên, đủ để điều hướng mà không thành danh bạ.
const services = (await getCollection('services', (e) => e.data.lang === locale))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const clinicLinks = [
  { key: 'about', label: t('nav.about') },
  { key: 'sterile', label: t('sterile.title') },
  { key: 'technology', label: t('tech.title') },
  { key: 'kids', label: t('kids.title') },
  { key: 'pricing', label: t('nav.pricing') },
  { key: 'blog', label: t('nav.blog') },
  { key: 'contact', label: t('nav.contact') },
] as const;

const mapsHref = clinic.mapsUrl;
const todayYear = new Date().getFullYear();
---

<footer class="border-t border-steel bg-surface-sunken">
  {
    /* Dải phân cách mang màu thương hiệu, không phải màu sứ.
      Màu sứ là dữ liệu sắc độ răng, dùng làm trang trí là gán nghĩa sai. */
  }
  <div
    class="h-1"
    style="background: linear-gradient(90deg, var(--accent), var(--secondary))"
    aria-hidden="true"
  >
  </div>

  <Container wide class="py-12 lg:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.3fr] lg:gap-12">
      <div>
        <div class="flex items-center gap-2.5">
          <BrandMark class="size-9" />
          <span class="leading-none">
            <span
              class="block text-[1.0625rem] font-semibold"
              style="font-variation-settings: 'wdth' 108"
            >
              {clinic.name}
            </span>
            <span class="mt-0.5 block text-[0.6875rem] measure text-ink-3">{clinic.tagline}</span>
          </span>
        </div>

        <address class="mt-5 space-y-2.5 text-sm leading-relaxed text-ink-2 not-italic">
          <a
            href={mapsHref}
            target="_blank"
            rel="noopener"
            class="flex gap-2.5 transition-colors duration-300 hover:text-accent active:text-accent-hover"
          >
            <Icon
              name="ph:map-pin"
              class="text-secondary mt-0.5 size-4 shrink-0"
              aria-hidden="true"
            />
            <span>{clinic.address.street}<br />{clinic.address.ward}, {clinic.address.city}</span>
          </a>
          <a
            href={telHref(clinic.phone)}
            class="flex items-center gap-2.5 transition-colors duration-300 hover:text-accent active:text-accent-hover"
          >
            <Icon name="ph:phone-call" class="text-secondary size-4 shrink-0" aria-hidden="true" />
            <span class="measure">{clinic.phone}</span>
          </a>
          <a
            href={zaloHref(clinic.zalo)}
            class="flex items-center gap-2.5 transition-colors duration-300 hover:text-accent active:text-accent-hover"
          >
            <Icon
              name="simple-icons:zalo"
              class="text-secondary size-4 shrink-0"
              aria-hidden="true"
            />
            <span class="measure">{clinic.zalo}</span>
          </a>
          <a
            href={`mailto:${clinic.email}`}
            class="flex items-center gap-2.5 transition-colors duration-300 hover:text-accent active:text-accent-hover"
          >
            <Icon
              name="ph:envelope-simple"
              class="text-secondary size-4 shrink-0"
              aria-hidden="true"
            />
            <span>{clinic.email}</span>
          </a>
        </address>
      </div>

      <nav aria-labelledby="f-services">
        <h2 id="f-services" class="text-sm font-semibold">{t('footer.services')}</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            services.map((s) => (
              <li>
                <a href={pathFor(`service:${s.data.key as ServiceKey}`, locale)} class="link-slide">
                  {s.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="f-clinic">
        <h2 id="f-clinic" class="text-sm font-semibold">{t('footer.about')}</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            clinicLinks.map(({ key, label }) => (
              <li>
                <a href={pathFor(key, locale)} class="link-slide">
                  {label}
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-7 text-sm font-semibold">{t('footer.follow')}</h2>
        <div class="mt-3 flex gap-2">
          <a
            href={clinic.sameAs.facebook}
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
            class="flex size-10 items-center justify-center rounded-full border border-steel-edge transition-all duration-300 hover:border-accent hover:bg-accent-quiet hover:text-accent active:translate-y-px"
          >
            <Icon name="simple-icons:facebook" class="size-4" aria-hidden="true" />
          </a>
          <a
            href={clinic.sameAs.googleBusiness}
            target="_blank"
            rel="noopener"
            aria-label="Google"
            class="flex size-10 items-center justify-center rounded-full border border-steel-edge transition-all duration-300 hover:border-accent hover:bg-accent-quiet hover:text-accent active:translate-y-px"
          >
            <Icon name="simple-icons:google" class="size-4" aria-hidden="true" />
          </a>
        </div>
      </nav>

      {/* Giờ làm việc đọc từ clinic.ts, cùng nguồn với trang Liên hệ. */}
      <section aria-labelledby="f-hours">
        <h2 id="f-hours" class="text-sm font-semibold">{t('footer.hours')}</h2>
        <dl class="mt-4 text-sm">
          {
            days.map(([day, value]) => (
              <div class="flex justify-between gap-4 border-b border-steel py-2 last:border-0">
                <dt class="text-ink-2">{DAY_LABELS[locale][day]}</dt>
                <dd class="measure">
                  {value === 'closed' ? t('footer.closed') : `${value.open} - ${value.close}`}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    {
      clinic.isDemoData && (
        <p class="border-warning/40 bg-warning/5 mt-10 flex gap-2.5 rounded-md border p-3 text-sm text-signal">
          <Icon name="ph:warning" class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
          {t('footer.demoWarning')}
        </p>
      )
    }

    <div
      class="mt-10 flex flex-col gap-2 border-t border-steel pt-6 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {todayYear} {clinic.legalName}. {t('footer.rights')}</p>
      <p class="measure">{t('footer.licence')} {clinic.licenceNumber}</p>
    </div>
  </Container>
</footer>
