---
/**
 * Lưới dịch vụ trên trang chủ.
 *
 * Bản trước chỉ có một ô màu và cái tên, rê chuột vào không hiện gì thêm, nên
 * khách không biết dịch vụ đó là gì trước khi bấm. Giờ mỗi thẻ mang mô tả thật
 * lấy từ nội dung trang, và rê chuột thì mũi tên trượt ra báo bấm được.
 *
 * Không dùng màu sứ be ở đây: màu đó là dữ liệu sắc độ răng, không phải màu
 * phân loại dịch vụ. Dùng nó làm nhãn phân loại là gán nghĩa sai cho dữ liệu.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import type { Locale } from '../i18n/locales';
import { type ServiceKey, pathFor } from '../i18n/routes';

interface Props {
  locale: Locale;
  limit?: number;
}

const { locale, limit = 6 } = Astro.props;

const ICON: Record<string, string> = {
  implant: 'ph:tooth',
  veneer: 'ph:sparkle',
  crown: 'ph:crown-simple',
  bridge: 'ph:bridge',
  denture: 'ph:hand-soap',
  gummySmile: 'ph:smiley',
  rootCanal: 'ph:first-aid-kit',
  scaling: 'ph:broom',
  fluoride: 'ph:baby',
  whitening: 'ph:sun',
  braces: 'ph:align-center-horizontal',
};

const services = (await getCollection('services', (e) => e.data.lang === locale))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, limit);
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    services.map((s) => (
      <li>
        <a href={pathFor(`service:${s.data.key as ServiceKey}`, locale)} class="card">
          <span class="card-icon">
            <Icon name={ICON[s.data.key] ?? 'ph:tooth'} class="size-5" aria-hidden="true" />
          </span>

          <h3 class="card-title">{s.data.title}</h3>
          <p class="card-body">{s.data.description}</p>

          <span class="card-more">
            <span class="card-more-line" />
            <Icon name="ph:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
    padding: 1.375rem;
    border: 1px solid var(--steel-line);
    border-radius: var(--r-lg);
    background: var(--surface-raised);
    transition:
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      translate 0.3s var(--ease-out);
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--accent);
    translate: 0 -3px;
    box-shadow: 0 18px 32px -24px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r-md);
    background: var(--secondary-quiet);
    color: var(--secondary);
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .card:hover .card-icon {
    background: var(--accent-quiet);
    color: var(--accent);
  }

  .card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    transition: color 0.3s var(--ease-out);
  }
  .card:hover .card-title {
    color: var(--accent);
  }

  /* Mô tả thật của dịch vụ, cắt gọn ba dòng để các thẻ đều nhau. */
  .card-body {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* Mũi tên trượt ra khi rê chuột, kèm một vạch kéo dài. Nó nói rằng thẻ này
     bấm được và còn nội dung phía sau. */
  .card-more {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--text-tertiary);
    transition: color 0.3s var(--ease-out);
  }
  .card:hover .card-more {
    color: var(--accent);
  }

  .card-more-line {
    display: block;
    width: 1.25rem;
    height: 1.5px;
    border-radius: var(--r-pill);
    background: currentColor;
    transition: width 0.3s var(--ease-out);
  }
  .card:hover .card-more-line {
    width: 2.5rem;
  }
</style>
