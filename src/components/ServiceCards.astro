---
/**
 * Lưới dịch vụ trên trang chủ.
 *
 * Bản trước chỉ có một ô màu và cái tên, rê chuột vào không hiện gì thêm, nên
 * khách không biết dịch vụ đó là gì trước khi bấm. Giờ mỗi thẻ mang mô tả thật
 * lấy từ nội dung trang, và rê chuột thì mũi tên trượt ra báo bấm được.
 *
 * Không dùng màu sứ be ở đây: màu đó là dữ liệu sắc độ răng, không phải màu
 * phân loại dịch vụ. Dùng nó làm nhãn phân loại là gán nghĩa sai cho dữ liệu.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import type { Locale } from '../i18n/locales';
import { type ServiceKey, pathFor } from '../i18n/routes';

interface Props {
  locale: Locale;
  limit?: number;
}

const { locale, limit = 6 } = Astro.props;

const ICON: Record<string, string> = {
  implant: 'ph:tooth',
  veneer: 'ph:sparkle',
  crown: 'ph:crown-simple',
  bridge: 'ph:bridge',
  denture: 'ph:hand-soap',
  gummySmile: 'ph:smiley',
  rootCanal: 'ph:first-aid-kit',
  scaling: 'ph:broom',
  fluoride: 'ph:baby',
  whitening: 'ph:sun',
  braces: 'ph:align-center-horizontal',
};

const services = (await getCollection('services', (e) => e.data.lang === locale))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, limit);
---

<ul data-grid="services" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    services.map((s) => (
      <li>
        <a
          href={pathFor(`service:${s.data.key as ServiceKey}`, locale)}
          class="group flex h-full flex-col gap-2.5 rounded-lg border border-steel bg-surface-raised p-[1.375rem] transition-[border-color,box-shadow,translate] duration-300 ease-[var(--ease-out)] hover:-translate-y-[3px] hover:border-accent hover:shadow-[0_18px_32px_-24px_color-mix(in_srgb,var(--accent)_60%,transparent)] focus-visible:border-accent"
        >
          <span class="bg-secondary-quiet text-secondary flex size-10 items-center justify-center rounded-md transition-colors duration-300 ease-[var(--ease-out)] group-hover:bg-accent-quiet group-hover:text-accent">
            <Icon name={ICON[s.data.key] ?? 'ph:tooth'} class="size-5" aria-hidden="true" />
          </span>

          <h3 class="text-[1.0625rem] font-semibold transition-colors duration-300 ease-[var(--ease-out)] group-hover:text-accent">
            {s.data.title}
          </h3>
          <p class="line-clamp-3 text-sm leading-[1.55] text-ink-2">{s.data.description}</p>

          <span class="mt-auto flex items-center gap-2 pt-3 text-ink-3 transition-colors duration-300 ease-[var(--ease-out)] group-hover:text-accent">
            <span class="block h-[1.5px] w-5 rounded-full bg-current transition-[width] duration-300 ease-[var(--ease-out)] group-hover:w-10" />
            <Icon name="ph:arrow-right" class="size-4 shrink-0" aria-hidden="true" />
          </span>
        </a>
      </li>
    ))
  }
</ul>
