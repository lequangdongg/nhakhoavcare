---
/**
 * Bảng lệnh tìm kiếm.
 *
 * Chỉ mục TẢI LƯỜI: 0 KB cho tới khi khách chủ động mở. Đây là phần JavaScript
 * duy nhất ngoài đoạn chống lóe sáng khi đổi giao diện.
 *
 * Nhóm "Hành động nhanh" đứng đầu là chủ ý: nó biến ô tìm kiếm từ tiện ích tra cứu
 * thành công cụ chuyển đổi. Khách mở lên định tìm thông tin, thấy nút gọi trước tiên.
 */
import { Icon } from 'astro-icon/components';
import { clinic, telHref, zaloHref } from '../data/clinic';
import { alternateLinks } from '../i18n/routes';
import { useTranslations, UI } from '../i18n/ui';
import { THEME_STORAGE_KEY } from '../lib/theme';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const indexUrl = locale === 'vi' ? '/search-index.json' : '/en/search-index.json';
const mapsHref = clinic.mapsUrl;
const other = alternateLinks(Astro.url.pathname).find((a) => a.locale !== locale)!;

const quickActions = [
  { href: telHref(clinic.phone), icon: 'ph:phone-call', label: `${t('cta.call')} ${clinic.phone}` },
  { href: zaloHref(clinic.zalo), icon: 'simple-icons:zalo', label: t('cta.zalo') },
  { href: mapsHref, icon: 'ph:map-pin-area', label: t('cta.directions') },
];

const themeOptions = [
  { value: 'system', icon: 'ph:desktop', label: t('theme.system') },
  { value: 'light', icon: 'ph:sun', label: t('theme.light') },
  { value: 'dark', icon: 'ph:moon', label: t('theme.dark') },
];
---

{
  /*
  Nút mở tìm kiếm. Trên màn rộng hiện dạng thanh có chữ gợi ý và phím tắt, để
  khách biết tính năng tồn tại mà không phải mò. Trên mobile thu về nút tròn
  vì chỗ trên header có hạn và bàn phím vật lý không có.
*/
}
<button
  type="button"
  data-search-open
  class="group flex size-10 items-center justify-center rounded-full border border-steel-edge transition-colors duration-300 hover:border-accent hover:bg-accent-quiet md:h-10 md:w-auto md:gap-2.5 md:rounded-full md:px-3.5"
  aria-label={t('search.open')}
>
  <Icon
    name="ph:magnifying-glass"
    class="size-[1.15rem] shrink-0 text-ink-3 transition-colors duration-300 group-hover:text-accent"
    aria-hidden="true"
  />
  <span
    class="hidden text-sm text-ink-3 transition-colors duration-300 group-hover:text-ink md:inline"
  >
    {t('search.placeholderShort')}
  </span>
  <kbd class="hidden items-center gap-1 md:flex" aria-hidden="true">
    <span
      class="measure rounded-sm border border-steel-edge bg-surface-raised px-1.5 py-px text-[0.6875rem] leading-[1.4] text-ink-3"
      data-search-modkey>⌘</span
    >
    <span
      class="measure rounded-sm border border-steel-edge bg-surface-raised px-1.5 py-px text-[0.6875rem] leading-[1.4] text-ink-3"
      >K</span
    >
  </kbd>
</button>

{
  /*
  Dùng <dialog> gốc của trình duyệt: nhốt focus, phím Esc, và lớp phủ đều có sẵn,
  không phải tự viết. Trên mobile là tấm phủ toàn màn hình.
*/
}
<dialog
  data-search-dialog
  aria-label={t('search.open')}
  class="m-0 h-full max-h-none w-full max-w-none bg-surface p-0 backdrop:bg-ink/40 sm:mx-auto sm:mt-[8vh] sm:h-auto sm:max-h-[80vh] sm:w-[min(42rem,92vw)] sm:rounded-lg sm:border sm:border-steel-edge sm:shadow-2xl sm:shadow-ink/20"
>
  <div class="flex h-full flex-col sm:max-h-[80vh]">
    <div class="flex items-center gap-3 border-b border-steel px-4 py-3">
      <Icon name="ph:magnifying-glass" class="size-5 shrink-0 text-ink-3" aria-hidden="true" />
      <input
        type="search"
        data-search-input
        placeholder={t('search.placeholder')}
        autocomplete="off"
        spellcheck="false"
        aria-controls="search-results"
        class="min-w-0 flex-1 bg-transparent py-1.5 text-base outline-none placeholder:text-ink-3"
      />
      <button
        type="button"
        data-search-close
        class="flex size-9 shrink-0 items-center justify-center rounded-full text-ink-2 transition-colors duration-300 hover:bg-surface-sunken hover:text-ink"
        aria-label={t('search.close')}
      >
        <Icon name="ph:x" class="size-5" aria-hidden="true" />
      </button>
    </div>

    <div id="search-results" class="flex-1 overflow-y-auto overscroll-contain">
      {/* Kết quả tìm kiếm, chỉ hiện khi đã gõ */}
      <div data-search-hits hidden></div>

      {/* Trạng thái rỗng: không để trống, hiện sẵn hành động và tuỳ chọn */}
      <div data-search-default>
        <section aria-labelledby="sm-quick" class="border-b border-steel py-2">
          <h2 id="sm-quick" class="px-4 py-1.5 text-xs font-semibold text-ink-3">
            {t('search.quick')}
          </h2>
          <ul>
            {
              quickActions.map((a) => (
                <li>
                  <a
                    href={a.href}
                    data-search-item
                    class="flex min-h-11 items-center gap-3 px-4 py-2.5 transition-colors duration-300 hover:bg-surface-raised focus-visible:bg-surface-raised"
                  >
                    <Icon name={a.icon} class="size-5 shrink-0 text-accent" aria-hidden="true" />
                    <span>{a.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="sm-theme" class="border-b border-steel py-2">
          <h2 id="sm-theme" class="px-4 py-1.5 text-xs font-semibold text-ink-3">
            {t('theme.label')}
          </h2>
          <ul>
            {
              themeOptions.map((o) => (
                <li>
                  <button
                    type="button"
                    data-theme-set={o.value}
                    data-search-item
                    class="flex min-h-11 w-full items-center gap-3 px-4 py-2.5 text-start transition-colors duration-300 hover:bg-surface-raised focus-visible:bg-surface-raised aria-pressed:bg-accent-quiet"
                    aria-pressed="false"
                  >
                    <Icon name={o.icon} class="size-5 shrink-0 text-ink-2" aria-hidden="true" />
                    <span>{o.label}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="sm-lang" class="py-2">
          <h2 id="sm-lang" class="px-4 py-1.5 text-xs font-semibold text-ink-3">
            {UI[locale]['lang.current']}
          </h2>
          <ul>
            <li>
              <a
                href={other.path}
                hreflang={other.locale}
                data-search-item
                class="flex min-h-11 items-center gap-3 px-4 py-2.5 transition-colors duration-300 hover:bg-surface-raised focus-visible:bg-surface-raised"
              >
                <Icon name="ph:translate" class="size-5 shrink-0 text-ink-2" aria-hidden="true" />
                <span>{UI[other.locale]['lang.current']}</span>
              </a>
            </li>
          </ul>
        </section>
      </div>
    </div>

    <p class="border-t border-steel px-4 py-2 text-xs text-ink-3">{t('search.hint')}</p>
    <p data-search-status role="status" aria-live="polite" class="sr-only"></p>
  </div>
</dialog>

<script
  is:inline
  define:vars={{
    indexUrl,
    storageKey: THEME_STORAGE_KEY,
    labels: {
      empty: t('search.empty'),
      results: t('search.results'),
      services: t('nav.services'),
    },
  }}
>
  (() => {
    // Máy không phải Mac thì phím tắt là Ctrl, hiển thị cho đúng.
    if (!/Mac|iPhone|iPad/.test(navigator.platform || '')) {
      for (const el of document.querySelectorAll('[data-search-modkey]')) el.textContent = 'Ctrl';
    }

    const dialog = document.querySelector('[data-search-dialog]');
    const input = document.querySelector('[data-search-input]');
    const hits = document.querySelector('[data-search-hits]');
    const fallback = document.querySelector('[data-search-default]');
    const status = document.querySelector('[data-search-status]');
    if (!dialog || !input) return;

    let index = null;
    let trigger = null;

    // Bỏ dấu. Giữ khớp với src/lib/search.ts, đây là bản chạy trên trình duyệt.
    const fold = (s) =>
      s
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/[đĐ]/g, 'd')
        .toLowerCase()
        .replace(/\s+/g, ' ')
        .trim();

    async function load() {
      if (index) return index;
      const res = await fetch(indexUrl);
      index = await res.json();
      return index;
    }

    function open(from) {
      trigger = from ?? document.activeElement;
      dialog.showModal();
      input.focus();
      load();
    }

    function close() {
      dialog.close();
      // Trả con trỏ về đúng nút đã bấm
      if (trigger instanceof HTMLElement) trigger.focus();
    }

    function render(query) {
      const terms = fold(query).split(' ').filter(Boolean);
      if (!terms.length || !index) {
        hits.hidden = true;
        fallback.hidden = false;
        status.textContent = '';
        return;
      }

      const found = index
        .map((d) => {
          const title = fold(d.title);
          const keys = fold(d.keywords || '');
          const desc = fold(d.description);
          const hay = title + ' ' + keys + ' ' + desc;
          if (!terms.every((t) => hay.includes(t))) return null;
          let s = 0;
          // Khớp nguyên cụm thắng mọi thứ khác. Người Việt gõ "trong rang" là muốn
          // Implant, không phải Niềng răng, dù cả hai đều chứa chữ "rang" rời rạc.
          const phrase = terms.join(' ');
          if (terms.length > 1) {
            if (title.includes(phrase)) s += 220;
            else if (keys.includes(phrase)) s += 180;
            else if (desc.includes(phrase)) s += 60;
          }
          for (const t of terms) {
            if (title.startsWith(t)) s += 100;
            else if (title.includes(t)) s += 50;
            // Từ khoá là cách gọi khác do người viết chủ động khai, nên đáng tin
            // hơn việc từ đó tình cờ xuất hiện trong đoạn mô tả.
            if (keys.includes(t)) s += 40;
            if (desc.includes(t)) s += 10;
          }
          return { d, s: s - title.length * 0.1 };
        })
        .filter(Boolean)
        .sort((a, b) => b.s - a.s)
        .slice(0, 8);

      fallback.hidden = true;
      hits.hidden = false;
      status.textContent = `${found.length} ${labels.results}`;

      if (!found.length) {
        hits.innerHTML = `<p class="px-4 py-6 text-ink-2">${labels.empty}</p>`;
        return;
      }

      hits.innerHTML =
        '<ul>' +
        found
          .map(
            ({ d }) => `<li><a href="${d.href}" data-search-item
        class="flex min-h-11 flex-col justify-center gap-0.5 px-4 py-2.5 transition-colors duration-300 hover:bg-surface-raised focus-visible:bg-surface-raised">
        <span class="font-medium">${d.title}</span>
        <span class="text-xs text-ink-3">${d.group}</span></a></li>`,
          )
          .join('') +
        '</ul>';
    }

    function items() {
      return [...dialog.querySelectorAll('[data-search-item]')].filter((el) => el.offsetParent);
    }

    function move(step) {
      const list = items();
      if (!list.length) return;
      const i = list.indexOf(document.activeElement);
      list[(i + step + list.length) % list.length].focus();
    }

    document
      .querySelectorAll('[data-search-open]')
      .forEach((btn) => btn.addEventListener('click', () => open(btn)));
    dialog.querySelector('[data-search-close]')?.addEventListener('click', close);
    dialog.addEventListener('close', () => {
      if (trigger instanceof HTMLElement) trigger.focus();
    });

    input.addEventListener('input', () => render(input.value));

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        move(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        move(-1);
      } else if (e.key === 'Enter' && document.activeElement === input) {
        items()[0]?.click();
      }
    });

    // Bấm ra ngoài hộp thì đóng
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    document.addEventListener('keydown', (e) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName ?? '');
      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
        e.preventDefault();
        dialog.open ? close() : open();
      }
    });

    // Chuyển giao diện
    const applyTheme = (pref) => {
      const dark =
        pref === 'dark' ||
        (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', dark);
      dialog
        .querySelectorAll('[data-theme-set]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === pref)));
    };

    dialog.querySelectorAll('[data-theme-set]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const pref = btn.dataset.themeSet;
        try {
          pref === 'system'
            ? localStorage.removeItem(storageKey)
            : localStorage.setItem(storageKey, pref);
        } catch {}
        applyTheme(pref);
      }),
    );

    let stored = null;
    try {
      stored = localStorage.getItem(storageKey);
    } catch {}
    applyTheme(stored ?? 'system');
  })();
</script>
