---
/**
 * Bảng so màu răng VITA dựng bằng CSS thuần.
 *
 * Đây là hình ảnh chính của hero. Nó tồn tại vì hai lý do:
 *
 * 1. Phòng khám chưa có ảnh chụp. Ảnh stock nha khoa trông giả và phản tác dụng
 *    đúng vào mục tiêu uy tín, còn ô gạch đứt rỗng thì không phải là hero.
 * 2. Đây là vật thật khách đã thấy nếu từng bọc răng: bộ tab sứ bác sĩ giơ lên
 *    cạnh răng để chọn màu. Nhận ra nó chính là niềm tin.
 *
 * Dựng bằng CSS chứ không phải SVG tự vẽ, đúng luật Taste mục 9.E: các tab là
 * phần tử bố cục thật có màu là dữ liệu, không phải hình minh hoạ vẽ tay.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Sắc độ thật của bộ VITA classical, xếp từ sáng tới sẫm đúng cách bộ tab được sắp.
const tabs = [
  { code: 'B1', shade: 'var(--shade-b1)' },
  { code: 'A1', shade: 'var(--shade-a1)' },
  { code: 'A2', shade: 'var(--shade-a2)' },
  { code: 'B3', shade: 'var(--shade-b3)' },
  { code: 'A3', shade: 'var(--shade-a3)' },
  { code: 'C3', shade: 'var(--shade-c3)' },
  { code: 'A4', shade: 'var(--shade-a4)' },
];
---

{/* Khối chắc chắn có nền và viền, không để quạt trôi lơ lửng giữa khoảng trống. */}
<figure class:list={['shade-card', className]}>
  <div class="shade-fan" aria-hidden="true">
    <span class="fan-pivot"></span>
    <ol class="fan-tabs">
      {
        tabs.map((tab, i) => (
          <li class="fan-tab" style={`--i: ${i}; --tab-shade: ${tab.shade}`}>
            <span class="tab-body" />
            <span class="tab-code measure">{tab.code}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <figcaption class="shade-caption">
    <slot />
  </figcaption>
</figure>

<style>
  .shade-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--steel-line);
    border-radius: var(--r-lg);
    background:
      radial-gradient(120% 80% at 50% 0%, var(--surface-raised), transparent 70%), var(--surface);
    box-shadow: 0 24px 48px -32px rgb(15 26 28 / 0.35);
  }

  .shade-fan {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: 3.5rem 3rem;
  }

  /* Khung thép giữ các tab, trục xoay ở trên */
  .fan-pivot {
    position: absolute;
    top: 1.75rem;
    left: 50%;
    width: 2rem;
    height: 2rem;
    translate: -50% 0;
    border: 2px solid var(--steel-edge);
    border-radius: var(--r-pill);
    background: var(--surface-raised);
  }
  .fan-pivot::after {
    content: '';
    position: absolute;
    inset: 0.45rem;
    border-radius: var(--r-pill);
    background: var(--steel-edge);
  }

  .fan-tabs {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 2.4rem;
  }

  /* Xoè quạt: mỗi tab lệch một góc, gốc xoay ở đầu trên nơi khung thép giữ */
  .fan-tab {
    --spread: 10deg;
    position: relative;
    width: clamp(2.6rem, 6vw, 3.6rem);
    margin-inline: clamp(-0.5rem, -0.8vw, -0.3rem);
    transform-origin: top center;
    rotate: calc((var(--i) - 3) * var(--spread));
    transition: rotate 450ms var(--ease-out);
  }

  .tab-body {
    display: block;
    height: clamp(8.5rem, 20vw, 12rem);
    background: var(--tab-shade);
    border: 1px solid rgb(15 26 28 / 0.14);
    border-radius: 0.2rem 0.2rem 0.7rem 0.7rem;
    /* Bóng có độ lệch và độ nhoè thật, không phải quầng sáng phẳng */
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.55) inset,
      0 10px 20px -10px rgb(15 26 28 / 0.4);
  }

  /* Mã hiệu xoay ngược lại đúng bằng góc nghiêng của tab, nên luôn đọc ngang. */
  .tab-code {
    position: absolute;
    inset-inline: 0;
    bottom: -1.75rem;
    text-align: center;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
    rotate: calc((var(--i) - 3) * var(--spread) * -1);
  }

  /* Quạt xoè rộng thêm khi rê chuột. Một chuyển động duy nhất, có lý do:
     nó diễn tả đúng thao tác bác sĩ mở bộ tab ra để so màu. */
  .shade-card:hover .fan-tab {
    --spread: 12.5deg;
  }

  .shade-caption {
    border-top: 1px solid var(--steel-line);
    background: var(--surface-raised);
    padding: 1.125rem 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .fan-tab,
    .shade-card:hover .fan-tab {
      transition: none;
      --spread: 10deg;
    }
  }
</style>
