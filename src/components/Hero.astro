---
import { Icon } from 'astro-icon/components';
import { clinic, yearsInOperation } from '../data/clinic';
import type { Locale } from '../i18n/locales';
import { pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import ActionBar from './ActionBar.astro';
import Container from './Container.astro';
import HeroCarousel from './HeroCarousel.astro';

interface Props {
  locale: Locale;
  serviceCount: number;
}

const { locale, serviceCount } = Astro.props;
const t = useTranslations(locale);
const years = yearsInOperation();
---

<section class="relative overflow-hidden border-b border-steel">
  {
    /*
    Nền: quầng sáng lạnh từ trên xuống, gợi đèn điều trị. Rất nhạt để không
    cạnh tranh với chữ. Không dùng lưới kẻ vì nó đọc ra "hoạ tiết trang trí"
    chứ không phải chất liệu.
  */
  }
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(80% 60% at 50% -10%, var(--accent-quiet), transparent 62%)"
    aria-hidden="true"
  >
  </div>

  <Container
    wide
    class="relative grid items-center gap-10 py-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:py-20"
  >
    <div class="max-w-[40ch]">
      <p class="rise measure text-sm font-medium text-accent" style="--d: 0">
        {t('hero.eyebrow')}
      </p>

      <h1
        class="rise mt-3 text-[2.1rem] leading-[1.04] font-semibold sm:text-5xl lg:text-[3.4rem]"
        style="--d: 1"
      >
        {t('hero.title')}
      </h1>

      <p class="rise mt-5 max-w-[46ch] text-lg text-ink-2" style="--d: 2">{t('hero.sub')}</p>

      <div class="rise" style="--d: 3">
        <ActionBar locale={locale} class="mt-8" />
      </div>

      {
        /*
        Hai con số thật lấy từ dữ liệu: năm hoạt động tính từ foundedYear, số
        dịch vụ đếm từ collection. Không bịa số ca hay số bệnh nhân.
      */
      }
      <dl class="rise mt-10 flex gap-8 border-t border-steel pt-6" style="--d: 4">
        <div>
          <dt class="text-sm text-ink-2">{t('hero.years')}</dt>
          <dd class="measure mt-0.5 text-2xl font-semibold">{years}</dd>
        </div>
        <div class="border-s border-steel ps-8">
          <dt class="text-sm text-ink-2">{t('hero.services')}</dt>
          <dd class="measure mt-0.5 text-2xl font-semibold">{serviceCount}</dd>
        </div>
      </dl>
    </div>

    <div class="rise" style="--d: 3">
      <HeroCarousel locale={locale} />
    </div>
  </Container>
</section>
