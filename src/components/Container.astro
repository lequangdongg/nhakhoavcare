---
// Astro suy kiểu Astro.props từ interface này; trình kiểm tra không thấy nên báo thừa.
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
  wide?: boolean;
  [key: string]: unknown;
}

// ...rest cần cho các móc bố cục như data-part. Không có nó, mọi thuộc tính
// ngoài ba cái khai ở trên đều bị nuốt mất chứ không báo lỗi.
const { as: Tag = 'div', class: className = '', wide = false, ...rest } = Astro.props;
---

<Tag
  {...rest}
  class:list={['mx-auto w-full px-5 sm:px-8', wide ? 'max-w-[1400px]' : 'max-w-6xl', className]}
>
  <slot />
</Tag>
