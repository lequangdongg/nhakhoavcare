---
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
  wide?: boolean;
}

const { as: Tag = 'div', class: className = '', wide = false } = Astro.props;
---

<Tag class:list={['mx-auto w-full px-5 sm:px-8', wide ? 'max-w-[1400px]' : 'max-w-6xl', className]}>
  <slot />
</Tag>
