---
/**
 * So sánh ảnh trước và sau bằng thanh kéo.
 *
 * Tay kéo là <input type="range"> thật, chỉ được tạo kiểu lại. Nhờ vậy chuột,
 * ngón tay và bàn phím đều dùng được sẵn, trình đọc màn hình cũng đọc ra đây là
 * thanh trượt có giá trị. Tự viết bằng sự kiện chuột thì phải làm lại toàn bộ
 * những thứ đó và thường làm thiếu.
 *
 * Khung giữ nền sáng ở cả chế độ tối: mắt người đánh giá độ trắng của răng theo
 * nền xung quanh, nền tối làm kết quả trông phóng đại. Đây là ràng buộc đạo đức
 * nghề nghiệp, không phải lựa chọn thẩm mỹ.
 */
import { type ImageKey, images } from '../data/images';

interface Props {
  before: ImageKey;
  after: ImageKey;
  /** Tên ca điều trị, hiện dưới ảnh */
  caption: string;
  labelBefore: string;
  labelAfter: string;
  class?: string;
}

const { before, after, caption, labelBefore, labelAfter, class: className = '' } = Astro.props;

const b = images[before];
const a = images[after];
---

<figure class:list={['ba-wrap', className]}>
  <div class="ba" style={`aspect-ratio: ${b.ratio}`}>
    {/* Lớp dưới: ảnh sau, luôn hiện đủ */}
    <img class="ba-img" src={a.src} alt={a.alt} loading="lazy" decoding="async" />

    {/* Lớp trên: ảnh trước, bị cắt theo vị trí tay kéo */}
    <div class="ba-clip">
      <img class="ba-img" src={b.src} alt={b.alt} loading="lazy" decoding="async" />
    </div>

    <span class="ba-tag ba-tag-before">{labelBefore}</span>
    <span class="ba-tag ba-tag-after">{labelAfter}</span>

    <span class="ba-line" aria-hidden="true">
      <span class="ba-grip"></span>
    </span>

    <input
      class="ba-range"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-label={caption}
    />

    {(b.placeholder || a.placeholder) && <span class="ba-ph">{b.brief.split('.')[0]}</span>}
  </div>

  <figcaption class="ba-caption">{caption}</figcaption>
</figure>

<script is:inline>
  (() => {
    for (const el of document.querySelectorAll('.ba')) {
      const range = el.querySelector('.ba-range');
      const set = () => el.style.setProperty('--pos', range.value + '%');
      range.addEventListener('input', set);
      set();
    }
  })();
</script>

<style>
  .ba-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ba {
    --pos: 50%;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--clinical-edge);
    border-radius: var(--r-lg);
    /* Nền sáng ở CẢ HAI chế độ. Xem ghi chú đầu file. */
    background: var(--clinical-surface);
    touch-action: pan-y;
  }

  .ba-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Ảnh trước bị cắt tới vị trí tay kéo. Dùng clip-path chứ không phải width,
     để ảnh bên trong không bị bóp méo khi kéo. */
  .ba-clip {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .ba-tag {
    position: absolute;
    top: 0.6rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--r-sm);
    background: rgb(15 23 42 / 0.72);
    color: #f8fafc;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    pointer-events: none;
  }
  .ba-tag-before {
    inset-inline-start: 0.6rem;
  }
  .ba-tag-after {
    inset-inline-end: 0.6rem;
  }

  /* Đường kẻ và núm nắm. Chỉ để nhìn, mọi tương tác nằm ở input bên dưới. */
  .ba-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    translate: -1px 0;
    background: var(--accent-contrast);
    box-shadow: 0 0 0 1px rgb(15 23 42 / 0.18);
    pointer-events: none;
  }
  .ba-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    width: 2.25rem;
    height: 2.25rem;
    translate: -50% -50%;
    border-radius: var(--r-pill);
    background: var(--accent);
    box-shadow: 0 4px 14px -4px rgb(15 23 42 / 0.5);
  }
  /* Hai mũi tên nhỏ trong núm, vẽ bằng viền nên không cần thêm ảnh. */
  .ba-grip::before,
  .ba-grip::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    translate: 0 -50%;
    border-block: 4px solid transparent;
  }
  .ba-grip::before {
    left: 0.55rem;
    border-inline-end: 5px solid var(--accent-contrast);
  }
  .ba-grip::after {
    right: 0.55rem;
    border-inline-start: 5px solid var(--accent-contrast);
  }

  /* Thanh trượt thật, trong suốt, phủ kín ảnh. Đây là thứ nhận mọi thao tác.
     touch-action: pan-y là BẮT BUỘC: không có nó, ngón tay vuốt lên xuống để
     cuộn trang bị thanh trượt bắt mất, và người dùng mobile không cuộn qua
     được vùng ảnh. Với pan-y, trình duyệt giữ quyền cuộn dọc còn thao tác
     ngang mới đưa cho thanh trượt. */
  .ba-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .ba-range::-webkit-slider-thumb {
    appearance: none;
    width: 2.5rem;
    height: 100%;
    background: transparent;
    cursor: ew-resize;
  }
  .ba-range::-moz-range-thumb {
    width: 2.5rem;
    height: 100%;
    border: 0;
    background: transparent;
    cursor: ew-resize;
  }
  /* Bộ chọn ~ không dùng được ở đây vì input đứng SAU .ba-line trong DOM, mà ~
     chỉ chọn phần tử đứng sau. Dùng :has() trên phần tử cha. */
  .ba:has(.ba-range:focus-visible) .ba-grip {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .ba-ph {
    position: absolute;
    inset-inline: 0.6rem;
    bottom: 0.6rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--r-sm);
    background: rgb(15 23 42 / 0.78);
    color: var(--warning);
    font-size: 0.625rem;
    line-height: 1.3;
    pointer-events: none;
  }

  .ba-caption {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }
</style>
