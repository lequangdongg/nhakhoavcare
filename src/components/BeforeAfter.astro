---
/**
 * So sánh ảnh trước và sau bằng thanh kéo.
 *
 * Tay kéo là <input type="range"> thật, chỉ được tạo kiểu lại. Nhờ vậy chuột,
 * ngón tay và bàn phím đều dùng được sẵn, trình đọc màn hình cũng đọc ra đây là
 * thanh trượt có giá trị. Tự viết bằng sự kiện chuột thì phải làm lại toàn bộ
 * những thứ đó và thường làm thiếu.
 *
 * Khung giữ nền sáng ở cả chế độ tối: mắt người đánh giá độ trắng của răng theo
 * nền xung quanh, nền tối làm kết quả trông phóng đại. Đây là ràng buộc đạo đức
 * nghề nghiệp, không phải lựa chọn thẩm mỹ.
 */
import { type ImageKey, images } from '../data/images';

interface Props {
  before: ImageKey;
  after: ImageKey;
  /** Tên ca điều trị, hiện dưới ảnh */
  caption: string;
  labelBefore: string;
  labelAfter: string;
  class?: string;
}

const { before, after, caption, labelBefore, labelAfter, class: className = '' } = Astro.props;

const b = images[before];
const a = images[after];
---

<figure class:list={['flex flex-col gap-[0.6rem]', className]}>
  <div
    data-ba
    class="ba relative touch-pan-y overflow-hidden rounded-lg border border-[var(--clinical-edge)] bg-clinical [--pos:50%]"
    style={`aspect-ratio: ${b.ratio}`}
  >
    {/* Lớp dưới: ảnh sau, luôn hiện đủ */}
    <img
      class="absolute inset-0 block size-full object-cover"
      src={a.src}
      alt={a.alt}
      loading="lazy"
      decoding="async"
    />

    {/* Lớp trên: ảnh trước, bị cắt theo vị trí tay kéo */}
    <div class="absolute inset-0 [clip-path:inset(0_calc(100%-var(--pos))_0_0)]">
      <img
        class="absolute inset-0 block size-full object-cover"
        src={b.src}
        alt={b.alt}
        loading="lazy"
        decoding="async"
      />
    </div>

    <span
      class="pointer-events-none absolute start-2.5 top-2.5 rounded-sm bg-[rgb(15_23_42/0.72)] px-2 py-0.5 text-[0.6875rem] font-semibold tracking-[0.04em] text-[#f8fafc]"
      >{labelBefore}</span
    >
    <span
      class="pointer-events-none absolute end-2.5 top-2.5 rounded-sm bg-[rgb(15_23_42/0.72)] px-2 py-0.5 text-[0.6875rem] font-semibold tracking-[0.04em] text-[#f8fafc]"
      >{labelAfter}</span
    >

    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 left-[var(--pos)] w-0.5 -translate-x-px bg-accent-contrast shadow-[0_0_0_1px_rgb(15_23_42/0.18)]"
    >
      <span
        class="absolute top-1/2 left-1/2 flex size-9 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent shadow-[0_4px_14px_-4px_rgb(15_23_42/0.5)] before:absolute before:top-1/2 before:left-[0.55rem] before:size-0 before:-translate-y-1/2 before:border-y-4 before:border-e-[5px] before:border-y-transparent before:border-e-accent-contrast before:content-[''] after:absolute after:top-1/2 after:right-[0.55rem] after:size-0 after:-translate-y-1/2 after:border-y-4 after:border-s-[5px] after:border-y-transparent after:border-s-accent-contrast after:content-[''] [.ba:has(.ba-range:focus-visible)_&]:outline-2 [.ba:has(.ba-range:focus-visible)_&]:outline-offset-[3px] [.ba:has(.ba-range:focus-visible)_&]:outline-accent"
      ></span>
    </span>

    <input
      class="ba-range absolute inset-0 m-0 size-full cursor-ew-resize touch-pan-y appearance-none bg-transparent [&::-moz-range-thumb]:h-full [&::-moz-range-thumb]:w-10 [&::-moz-range-thumb]:cursor-ew-resize [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-transparent [&::-webkit-slider-thumb]:h-full [&::-webkit-slider-thumb]:w-10 [&::-webkit-slider-thumb]:cursor-ew-resize [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:bg-transparent"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-label={caption}
    />

    {
      (b.placeholder || a.placeholder) && (
        <span class="text-warning pointer-events-none absolute inset-x-2.5 bottom-2.5 rounded-sm bg-[rgb(15_23_42/0.78)] px-2 py-1.5 text-[0.625rem] leading-[1.3]">
          {b.brief.split('.')[0]}
        </span>
      )
    }
  </div>

  <figcaption class="text-sm font-medium text-ink-2">{caption}</figcaption>
</figure>

<script is:inline>
  (() => {
    for (const el of document.querySelectorAll('[data-ba]')) {
      const range = el.querySelector('.ba-range');
      const set = () => el.style.setProperty('--pos', range.value + '%');
      range.addEventListener('input', set);
      set();
    }
  })();
</script>
