---
/**
 * Thanh tiện ích trên cùng header.
 *
 * Bản trước là một mảng nền đen đặc chiếm hết chiều ngang, nặng nề và chỉ lặp
 * lại thông tin đã có ở footer. Bản này nhẹ hơn và mang một thứ footer không
 * làm được: TRẠNG THÁI ĐANG MỞ HAY ĐÃ ĐÓNG, tính theo đồng hồ của chính khách.
 *
 * Đây là câu hỏi đầu tiên của người tra cứu nha khoa lúc 21h tối. Trả lời được
 * nó ngay dòng đầu tiên đáng giá hơn mọi thứ trang trí.
 *
 * Chấm trạng thái là ngoại lệ hợp lệ của luật cấm chấm màu trang trí trong
 * Taste mục 9.F: nó mang trạng thái thật, không phải hoạ tiết.
 */
import { Icon } from 'astro-icon/components';
import { clinic, zaloHref } from '../data/clinic';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import Container from './Container.astro';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;
const t = useTranslations(locale);

// Bảng giờ đưa xuống trình duyệt để tính trạng thái theo đồng hồ của khách.
// Máy chủ dựng site không biết bây giờ là mấy giờ ở chỗ người xem.
const HOUR_KEYS = [
  'sunday',
  'monday',
  'tuesday',
  'wednesday',
  'thursday',
  'friday',
  'saturday',
] as const;
const hoursByDay = HOUR_KEYS.map((k) => {
  const v = clinic.hours[k];
  return v === 'closed' ? null : [v.open, v.close];
});
---

<div class:list={['overflow-hidden border-b border-steel bg-surface-sunken text-ink-2', className]}>
  <Container wide class="flex h-9 items-center gap-4 text-[0.8125rem] lg:h-10 lg:gap-5">
    {
      /* Trạng thái mở cửa. Hiện sau khi trình duyệt tính xong, tránh nhấp nháy sai.
        Đây là thứ giá trị nhất trên mobile: người tra cứu lúc 21h cần biết ngay
        gọi bây giờ có ai nghe máy không. */
    }
    <span
      data-status
      hidden
      class="flex flex-none items-center gap-[0.4rem] rounded-full py-[0.15rem] pr-2.5 pl-2 font-medium whitespace-nowrap data-[open=false]:bg-steel data-[open=false]:text-ink-3 data-[open=true]:bg-[color-mix(in_srgb,var(--success)_14%,transparent)] data-[open=true]:text-[color-mix(in_srgb,var(--success)_78%,var(--text-primary))]"
    >
      <span
        data-status-dot
        class="size-[0.45rem] rounded-full bg-current motion-reduce:animate-none [[data-open=true]_&]:animate-status-pulse"
      ></span>
      <span data-status-text></span>
    </span>

    {
      /* Ngoài giờ vẫn nhận tư vấn. Chỉ hiện KHI ĐÃ ĐÓNG CỬA — lúc đang mở thì nó
        là thông tin thừa, còn lúc 21h nó là thứ duy nhất người ta cần biết.
        Thay thế chỗ của dòng giờ mở cửa để thanh không dài thêm. */
    }
    {
      /* Bật/tắt bằng data- chứ không bằng thuộc tính hidden: hidden của HTML đến
        từ stylesheet mặc định của trình duyệt nên thua bất kỳ class nào, kể cả
        lg:flex. Biến thể data- có độ ưu tiên (0,2,0) nên luôn thắng .hidden. */
    }
    <a
      data-afterhours
      href={zaloHref(clinic.zalo)}
      class="hidden items-center gap-[0.4rem] whitespace-nowrap transition-colors duration-250 ease-[var(--ease-out)] hover:text-accent data-[show]:flex"
    >
      <Icon name="simple-icons:zalo" class="size-4 shrink-0 text-ink-3" aria-hidden="true" />
      <span>{t('status.afterHours')}</span>
    </a>

    <span data-todaywrap class="hidden items-center gap-[0.4rem] whitespace-nowrap lg:flex">
      <Icon name="ph:clock" class="size-4 shrink-0 text-ink-3" aria-hidden="true" />
      <span>{t('header.todayHours')}: <span data-today-hours></span></span>
    </span>

    <a
      href={clinic.mapsUrl}
      target="_blank"
      rel="noopener"
      class="hidden items-center gap-[0.4rem] whitespace-nowrap transition-colors duration-250 ease-[var(--ease-out)] hover:text-accent lg:flex"
    >
      <Icon name="ph:map-pin" class="size-4 shrink-0 text-ink-3" aria-hidden="true" />
      <span>{clinic.address.street}, {clinic.address.city}</span>
    </a>

    <div class="ms-auto flex items-center gap-1.5">
      <a
        href={zaloHref(clinic.zalo)}
        class="flex size-7 items-center justify-center rounded-full text-ink-3 transition-colors duration-250 ease-[var(--ease-out)] hover:bg-accent-quiet hover:text-accent"
        aria-label={t('cta.zalo')}
        title={t('cta.zalo')}
      >
        <Icon name="simple-icons:zalo" class="size-4" aria-hidden="true" />
      </a>
      <a
        href={clinic.sameAs.facebook}
        target="_blank"
        rel="noopener"
        class="flex size-7 items-center justify-center rounded-full text-ink-3 transition-colors duration-250 ease-[var(--ease-out)] hover:bg-accent-quiet hover:text-accent"
        aria-label="Facebook"
      >
        <Icon name="simple-icons:facebook" class="size-4" aria-hidden="true" />
      </a>
    </div>
  </Container>
</div>

<script
  is:inline
  define:vars={{
    hoursByDay,
    labels: {
      open: t('status.open'),
      closed: t('status.closed'),
      closesAt: t('status.closesAt'),
      closedToday: t('footer.closed'),
    },
  }}
>
  (() => {
    const now = new Date();
    const today = hoursByDay[now.getDay()];
    const hoursEl = document.querySelector('[data-today-hours]');
    const wrap = document.querySelector('[data-status]');
    const text = document.querySelector('[data-status-text]');
    const after = document.querySelector('[data-afterhours]');
    const todayWrap = document.querySelector('[data-todaywrap]');
    if (!wrap) return;

    // Đã đóng cửa: đổi dòng giờ mở cửa thành lời mời nhắn Zalo. Cùng một chỗ
    // trên thanh, nhưng nói đúng thứ người ta cần vào đúng lúc đó.
    const showAfterHours = () => {
      if (after) after.dataset.show = '';
      if (todayWrap) todayWrap.classList.remove('lg:flex');
    };

    if (!today) {
      if (hoursEl) hoursEl.textContent = labels.closedToday;
      text.textContent = labels.closed;
      wrap.dataset.open = 'false';
      wrap.hidden = false;
      showAfterHours();
      return;
    }

    const [open, close] = today;
    if (hoursEl) hoursEl.textContent = open + ' - ' + close;

    const toMin = (s) => Number(s.slice(0, 2)) * 60 + Number(s.slice(3, 5));
    const cur = now.getHours() * 60 + now.getMinutes();
    const isOpen = cur >= toMin(open) && cur < toMin(close);

    wrap.dataset.open = String(isOpen);
    text.textContent = isOpen ? labels.open + ' ' + labels.closesAt + ' ' + close : labels.closed;
    wrap.hidden = false;
    if (!isOpen) showAfterHours();
  })();
</script>
