---
/**
 * Dải sắc độ sứ VITA dùng làm ĐIỀU HƯỚNG, không phải trang trí.
 *
 * Vật thật: bộ tab sứ xếp trên khung thép, bác sĩ giơ lên cạnh răng để chọn màu.
 * Ở đây mỗi tab là một dịch vụ. Thứ tự đi từ sắc độ sáng nhất tới sẫm nhất,
 * đúng cách bộ VITA classical được sắp.
 *
 * Đây là chữ ký thị giác của site. Nó chỉ xuất hiện một lần trên trang chủ;
 * lặp lại là biến nó thành hoạ tiết.
 */
import { pathFor, type ServiceKey } from '../i18n/routes';
import type { Locale } from '../i18n/locales';

interface Tab {
  key: ServiceKey;
  code: string;
  label: string;
  shade: string;
}

interface Props {
  locale: Locale;
  tabs: readonly Tab[];
}

const { locale, tabs } = Astro.props;
---

<ol class="grid grid-cols-2 gap-px bg-steel sm:grid-cols-3 lg:grid-cols-6">
  {
    tabs.map(({ key, code, label, shade }) => (
      <li class="bg-surface">
        <a
          href={pathFor(`service:${key}`, locale)}
          class="group flex h-full flex-col justify-between gap-6 bg-surface p-5 transition-colors duration-300 hover:bg-surface-raised focus-visible:bg-surface-raised"
        >
          {/* Tab sứ. Màu là dữ liệu: nó định vị dịch vụ trên thang sắc độ. */}
          <span
            class="block h-14 w-full rounded-sm transition-transform duration-300 group-hover:scale-y-110"
            style={`background-color: ${shade}`}
            aria-hidden="true"
          />
          <span class="flex items-baseline justify-between gap-3">
            <span class="text-[0.95rem] leading-snug font-medium">{label}</span>
            <span class="measure shrink-0 text-xs text-ink-3">{code}</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>
