---
/**
 * Ba kênh liên hệ thật của khách Việt: gọi, Zalo, chỉ đường.
 * Bản launch đầu không có form, nên đây là toàn bộ đường chuyển đổi của site.
 * Mọi giá trị đọc từ clinic.ts.
 */
import { Icon } from 'astro-icon/components';
import { clinic, telHref, zaloHref } from '../data/clinic';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;
const t = useTranslations(locale);

const mapsHref = clinic.mapsUrl;
---

<div class:list={['flex flex-wrap items-center gap-3', className]}>
  <a
    href={telHref(clinic.phone)}
    class="inline-flex min-h-12 items-center gap-2.5 rounded-full bg-accent px-6 text-accent-contrast shadow-sm shadow-accent/25 transition-all duration-300 hover:bg-accent-hover hover:shadow-lg hover:shadow-accent/25 active:translate-y-px"
  >
    <Icon name="ph:phone-call" class="size-5 shrink-0" aria-hidden="true" />
    <span class="font-medium">{t('cta.call')}</span>
  </a>

  <a
    href={zaloHref(clinic.zalo)}
    class="inline-flex min-h-12 items-center gap-2.5 rounded-full border border-steel-edge bg-surface-raised px-6 transition-all duration-300 hover:border-accent hover:text-accent active:translate-y-px"
  >
    <Icon name="simple-icons:zalo" class="size-5 shrink-0" aria-hidden="true" />
    <span class="font-medium">{t('cta.zalo')}</span>
  </a>

  <a
    href={mapsHref}
    target="_blank"
    rel="noopener"
    class="link-slide min-h-12 rounded-full px-3 text-ink-2"
  >
    <Icon name="ph:map-pin-area" class="size-5 shrink-0" aria-hidden="true" />
    <span>{t('cta.directions')}</span>
  </a>
</div>
