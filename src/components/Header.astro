---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { clinic, telHref } from '../data/clinic';
import type { Locale } from '../i18n/locales';
import { type ServiceKey, pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import BrandMark from './BrandMark.astro';
import Container from './Container.astro';
import AppearanceMenu from './AppearanceMenu.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import NavDropdown, { type DropdownItem } from './NavDropdown.astro';
import SearchModal from './SearchModal.astro';
import UtilityBar from './UtilityBar.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const current = Astro.url.pathname;

/**
 * Bố cục stage đưa logo về giữa, nav sang trái, nhóm nút sang phải.
 * Chỉ từ desktop: dưới 1024px nav đã ẩn nên chia ba cột là vô nghĩa.
 * ms-0 để huỷ ms-auto mặc định, nếu không nav vẫn bị đẩy dạt sang phải.
 */
const BAR_BY_LAYOUT = [
  // rail: thanh điều hướng thành một khối nổi bo tròn, cách mép trên và hai
  // bên. Bỏ viền dưới vì giờ nó có viền quanh cả bốn cạnh.
  '[[data-layout=rail]_&]:mx-3 [[data-layout=rail]_&]:mt-3 [[data-layout=rail]_&]:lg:mx-auto',
  '[[data-layout=rail]_&]:lg:max-w-[76rem] [[data-layout=rail]_&]:rounded-full',
  '[[data-layout=rail]_&]:border [[data-layout=rail]_&]:border-steel',
  '[[data-layout=rail]_&]:shadow-lg [[data-layout=rail]_&]:shadow-ink/10',
].join(' ');

/**
 * slim: header rút về logo và nút gọi, mọi mục điều hướng dồn vào menu thả
 * xuống. Nút menu vốn chỉ hiện dưới 1024px nên phải bật lại cho desktop, nếu
 * không bố cục này sẽ không còn đường nào đi tới các trang khác.
 */
const SLIM = {
  nav: '[[data-layout=slim]_&]:lg:hidden',
  menu: '[[data-layout=slim]_&]:lg:block',
  utility: '[[data-layout=slim]_&]:hidden',
};

const STAGE = {
  bar: '[[data-layout=stage]_&]:lg:grid [[data-layout=stage]_&]:lg:grid-cols-[1fr_auto_1fr]',
  brand: '[[data-layout=stage]_&]:lg:order-2 [[data-layout=stage]_&]:lg:justify-self-center',
  nav: '[[data-layout=stage]_&]:lg:order-1 [[data-layout=stage]_&]:lg:ms-0 [[data-layout=stage]_&]:lg:justify-self-start',
  tools:
    '[[data-layout=stage]_&]:lg:order-3 [[data-layout=stage]_&]:lg:ms-0 [[data-layout=stage]_&]:lg:justify-self-end',
};

const serviceItems: DropdownItem[] = (
  await getCollection('services', (e) => e.data.lang === locale)
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6)
  .map((s) => ({
    href: pathFor(`service:${s.data.key as ServiceKey}`, locale),
    title: s.data.title,
    // Câu đầu của mô tả, đủ để phân biệt mà không tràn dòng.
    description: `${s.data.description.split('.')[0]}.`,
    icon: 'ph:tooth',
  }));

const aboutItems: DropdownItem[] = [
  {
    href: pathFor('about', locale),
    title: t('nav.about'),
    description: t('navd.aboutDesc'),
    icon: 'ph:buildings',
  },
  {
    href: pathFor('pricing', locale),
    title: t('nav.pricing'),
    description: t('navd.pricingDesc'),
    icon: 'ph:receipt',
  },
  {
    href: pathFor('blog', locale),
    title: t('nav.blog'),
    description: t('navd.blogDesc'),
    icon: 'ph:book-open-text',
  },
  {
    href: pathFor('contact', locale),
    title: t('nav.contact'),
    description: t('navd.contactDesc'),
    icon: 'ph:map-pin-area',
  },
];

const mobileNav = [
  { key: 'about', label: t('nav.about') },
  { key: 'services', label: t('nav.services') },
  { key: 'pricing', label: t('nav.pricing') },
  { key: 'blog', label: t('nav.blog') },
  { key: 'contact', label: t('nav.contact') },
] as const;
---

<header class="sticky top-0 z-40">
  <UtilityBar locale={locale} class={SLIM.utility} />

  <div class:list={['border-b border-steel bg-surface/90 backdrop-blur-md', BAR_BY_LAYOUT]}>
    <Container
      wide
      data-part="headerbar"
      class:list={['flex h-15 items-center gap-4 lg:h-16', STAGE.bar]}
    >
      <a
        href={pathFor('home', locale)}
        data-part="brand"
        class:list={['flex shrink-0 items-center gap-2.5', STAGE.brand]}
      >
        {/* Nhận diện: một tab sứ trên khung thép, vật thật của bộ so màu. */}
        <BrandMark class="size-8" />
        {
          /*
          Bỏ dòng tagline ở đây: hero đã nói điều đó to hơn nhiều, và nó làm
          header cao thêm một tầng không cần thiết. Tagline vẫn ở footer.
        */
        }
        <span class="text-[1.0625rem] font-semibold" style="font-variation-settings: 'wdth' 108">
          {clinic.name}
        </span>
      </a>

      <nav
        aria-label={t('nav.primary')}
        data-mainnav
        data-part="nav"
        class:list={['relative ms-auto hidden items-center gap-1 lg:flex', STAGE.nav, SLIM.nav]}
      >
        {/* Một khối nền duy nhất, trượt sang mục đang được rê. Xem ghi chú ở script. */}
        <span
          data-navind
          aria-hidden="true"
          class="pointer-events-none absolute top-0 left-0 h-[var(--h,0px)] w-[var(--w,0px)] translate-x-[var(--x,0px)] translate-y-[var(--y,0px)] rounded-md bg-surface-sunken opacity-0 transition-[translate,width,height,opacity] duration-300 ease-[var(--ease-out)] motion-reduce:transition-[opacity] [[data-ind=on]_&]:opacity-100"
        >
        </span>

        <NavDropdown
          label={t('nav.services')}
          items={serviceItems}
          allHref={pathFor('services', locale)}
          allLabel={t('navd.allServices')}
          active={current.startsWith(pathFor('services', locale))}
        />
        <NavDropdown
          label={t('navd.clinic')}
          items={aboutItems}
          allHref={pathFor('about', locale)}
          allLabel={t('navd.allAbout')}
          active={current === pathFor('about', locale) || current === pathFor('pricing', locale)}
        />
        <a
          href={pathFor('contact', locale)}
          aria-current={current === pathFor('contact', locale) ? 'page' : undefined}
          data-navitem
          data-active={current === pathFor('contact', locale) ? 'true' : undefined}
          class:list={[
            'relative z-10 px-3 py-2 text-[0.9375rem] transition-colors duration-300 hover:text-ink',
            "after:absolute after:inset-x-3 after:bottom-0.5 after:h-0.5 after:scale-x-0 after:rounded-full after:bg-accent after:transition-transform after:duration-300 after:ease-[var(--ease-out)] after:content-[''] hover:after:scale-x-100 data-[active]:after:scale-x-100",
            current === pathFor('contact', locale) ? 'text-ink' : 'text-ink-2',
          ]}
        >
          {t('nav.contact')}
        </a>
      </nav>

      <div data-part="tools" class:list={['ms-auto flex items-center gap-2 lg:ms-2', STAGE.tools]}>
        <SearchModal locale={locale} />
        <AppearanceMenu locale={locale} />
        <LanguageSwitcher locale={locale} />

        <a
          href={telHref(clinic.phone)}
          class="hidden min-h-11 items-center gap-2.5 rounded-full bg-accent px-5 text-accent-contrast shadow-sm shadow-accent/25 transition-all duration-300 hover:bg-accent-hover hover:shadow-md hover:shadow-accent/30 active:translate-y-px sm:inline-flex"
        >
          <Icon name="ph:phone-call" class="size-5 shrink-0" aria-hidden="true" />
          <span class="leading-tight">
            <span class="block text-[0.6875rem] opacity-80">{t('cta.call')}</span>
            <span class="block text-[0.9375rem] font-semibold measure">{clinic.phone}</span>
          </span>
        </a>

        <details
          class:list={[
            'lg:hidden [&[open]_.menu-close]:block [&[open]_.menu-open]:hidden',
            SLIM.menu,
          ]}
        >
          <summary
            class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-steel-edge transition-colors duration-300 hover:bg-surface-sunken"
            aria-label={t('nav.openMenu')}
          >
            <Icon name="ph:list" class="menu-open size-5" aria-hidden="true" />
            <Icon name="ph:x" class="menu-close hidden size-5" aria-hidden="true" />
          </summary>

          <div
            class="absolute inset-x-0 top-16 border-y border-steel bg-surface-raised shadow-xl shadow-ink/10 [[open]>&]:animate-menu-in motion-reduce:[[open]>&]:animate-none"
          >
            <ul class="divide-y divide-steel">
              {
                mobileNav.map(({ key, label }) => (
                  <li>
                    <a
                      href={pathFor(key, locale)}
                      class="block px-5 py-4 text-[1.0625rem] transition-colors duration-300 hover:bg-surface-sunken"
                    >
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="p-4">
              <a
                href={telHref(clinic.phone)}
                class="flex min-h-13 items-center justify-center gap-2.5 rounded-full bg-accent px-5 text-accent-contrast"
              >
                <Icon name="ph:phone-call" class="size-5 shrink-0" aria-hidden="true" />
                <span class="font-semibold measure">{clinic.phone}</span>
              </a>
            </div>
          </div>
        </details>
      </div>
    </Container>
  </div>
</header>

<script is:inline>
  // Khối nền dùng chung cho hàng nav.
  //
  // Trước đây mỗi mục tự vẽ nền và tự chạy hiệu ứng của nó. Rê chuột nhanh qua
  // lại thì hai mục cùng chạy dở dang một lúc, mắt đọc ra là giật. Ở đây chỉ có
  // MỘT khối nền: nó trượt và giãn sang mục đang được rê, nên dù rê nhanh cỡ
  // nào cũng chỉ có một vật chuyển động, và nó luôn chạy tiếp từ chỗ đang đứng.
  (() => {
    const nav = document.querySelector('[data-mainnav]');
    if (!nav) return;
    const ind = nav.querySelector('[data-navind]');
    const items = nav.querySelectorAll('[data-navitem]');
    let visible = false;

    const moveTo = (el) => {
      const n = nav.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      // Lần đầu hiện: tắt hiệu ứng trong một khung hình, nếu không khối nền bay
      // từ mép trái sang thay vì lặng lẽ hiện ra đúng chỗ.
      if (!visible) ind.style.transition = 'none';
      ind.style.setProperty('--x', `${r.left - n.left}px`);
      ind.style.setProperty('--y', `${r.top - n.top}px`);
      ind.style.setProperty('--w', `${r.width}px`);
      ind.style.setProperty('--h', `${r.height}px`);
      if (!visible) {
        void ind.offsetWidth; // ép trình duyệt chốt vị trí trước khi bật lại
        ind.style.transition = '';
        visible = true;
        nav.dataset.ind = 'on';
      }
    };

    const hide = () => {
      visible = false;
      delete nav.dataset.ind;
    };

    for (const el of items) {
      el.addEventListener('pointerenter', () => moveTo(el));
      el.addEventListener('focus', () => moveTo(el));
    }
    // Bảng menu con nằm trong nav nên rê xuống bảng không tính là rời nav.
    nav.addEventListener('pointerleave', hide);
    nav.addEventListener('focusout', (e) => {
      if (!nav.contains(e.relatedTarget)) hide();
    });
  })();
</script>
