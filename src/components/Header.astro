---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { clinic, telHref, zaloHref } from '../data/clinic';
import type { Locale } from '../i18n/locales';
import { type ServiceKey, pathFor } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import BrandMark from './BrandMark.astro';
import Container from './Container.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import NavDropdown, { type DropdownItem } from './NavDropdown.astro';
import SearchModal from './SearchModal.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const current = Astro.url.pathname;

const serviceItems: DropdownItem[] = (
  await getCollection('services', (e) => e.data.lang === locale)
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6)
  .map((s) => ({
    href: pathFor(`service:${s.data.key as ServiceKey}`, locale),
    title: s.data.title,
    // Câu đầu của mô tả, đủ để phân biệt mà không tràn dòng.
    description: `${s.data.description.split('.')[0]}.`,
    icon: 'ph:tooth',
  }));

const aboutItems: DropdownItem[] = [
  {
    href: pathFor('about', locale),
    title: t('nav.about'),
    description: t('navd.aboutDesc'),
    icon: 'ph:buildings',
  },
  {
    href: pathFor('pricing', locale),
    title: t('nav.pricing'),
    description: t('navd.pricingDesc'),
    icon: 'ph:receipt',
  },
  {
    href: pathFor('blog', locale),
    title: t('nav.blog'),
    description: t('navd.blogDesc'),
    icon: 'ph:book-open-text',
  },
  {
    href: pathFor('contact', locale),
    title: t('nav.contact'),
    description: t('navd.contactDesc'),
    icon: 'ph:map-pin-area',
  },
];

const mobileNav = [
  { key: 'about', label: t('nav.about') },
  { key: 'services', label: t('nav.services') },
  { key: 'pricing', label: t('nav.pricing') },
  { key: 'blog', label: t('nav.blog') },
  { key: 'contact', label: t('nav.contact') },
] as const;

// Giờ mở cửa hôm nay. Khách vào site buổi tối cần biết ngay mai mấy giờ mở.
const DAYS = [
  'sunday',
  'monday',
  'tuesday',
  'wednesday',
  'thursday',
  'friday',
  'saturday',
] as const;
const today = clinic.hours[DAYS[new Date().getDay()]!];
const todayLabel = today === 'closed' ? t('footer.closed') : `${today.open} - ${today.close}`;
---

<header class="sticky top-0 z-40">
  <div class="hidden bg-ink text-surface lg:block">
    <Container wide class="flex h-10 items-center gap-6 text-[0.8125rem]">
      <span class="flex items-center gap-1.5 opacity-85">
        <Icon name="ph:map-pin" class="size-4 shrink-0" aria-hidden="true" />
        <span>{clinic.address.street}, {clinic.address.city}</span>
      </span>
      <span class="flex items-center gap-1.5 opacity-85">
        <Icon name="ph:clock" class="size-4 shrink-0" aria-hidden="true" />
        <span>{t('header.todayHours')}: {todayLabel}</span>
      </span>
      <a
        href={zaloHref(clinic.zalo)}
        class="ms-auto flex items-center gap-1.5 opacity-85 transition-opacity duration-300 hover:opacity-100"
      >
        <Icon name="simple-icons:zalo" class="size-4 shrink-0" aria-hidden="true" />
        <span>{t('cta.zalo')}</span>
      </a>
      <a href={clinic.sameAs.facebook} target="_blank" rel="noopener" aria-label="Facebook">
        <Icon
          name="simple-icons:facebook"
          class="size-4 opacity-85 transition-opacity duration-300 hover:opacity-100"
        />
      </a>
    </Container>
  </div>

  <div class="border-b border-steel bg-surface/90 backdrop-blur-md">
    <Container wide class="flex h-16 items-center gap-4 lg:h-[4.5rem]">
      <a href={pathFor('home', locale)} class="flex shrink-0 items-center gap-2.5">
        {/* Nhận diện: một tab sứ trên khung thép, vật thật của bộ so màu. */}
        <BrandMark class="size-9" />
        <span class="leading-none">
          <span
            class="block text-[1.0625rem] font-semibold"
            style="font-variation-settings: 'wdth' 108"
          >
            {clinic.name}
          </span>
          <span class="measure mt-0.5 block text-[0.6875rem] text-ink-3">{clinic.tagline}</span>
        </span>
      </a>

      <nav aria-label={t('nav.primary')} class="ms-auto hidden items-center gap-6 lg:flex">
        <NavDropdown
          label={t('nav.services')}
          items={serviceItems}
          allHref={pathFor('services', locale)}
          allLabel={t('navd.allServices')}
          active={current.startsWith(pathFor('services', locale))}
        />
        <NavDropdown
          label={t('navd.clinic')}
          items={aboutItems}
          allHref={pathFor('about', locale)}
          allLabel={t('navd.allAbout')}
          active={current === pathFor('about', locale) || current === pathFor('pricing', locale)}
        />
        <a
          href={pathFor('contact', locale)}
          aria-current={current === pathFor('contact', locale) ? 'page' : undefined}
          class:list={[
            'nav-link relative px-1 py-2 text-[0.9375rem] transition-colors duration-300 hover:text-ink',
            current === pathFor('contact', locale) ? 'is-active text-ink' : 'text-ink-2',
          ]}
        >
          {t('nav.contact')}
        </a>
      </nav>

      <div class="ms-auto flex items-center gap-2 lg:ms-2">
        <SearchModal locale={locale} />
        <LanguageSwitcher locale={locale} />

        <a
          href={telHref(clinic.phone)}
          class="hidden min-h-11 items-center gap-2.5 rounded-full bg-accent px-5 text-accent-contrast shadow-sm shadow-accent/25 transition-all duration-300 hover:bg-accent-hover hover:shadow-md hover:shadow-accent/30 active:translate-y-px sm:inline-flex"
        >
          <Icon name="ph:phone-call" class="size-5 shrink-0" aria-hidden="true" />
          <span class="leading-tight">
            <span class="block text-[0.6875rem] opacity-80">{t('cta.call')}</span>
            <span class="measure block text-[0.9375rem] font-semibold">{clinic.phone}</span>
          </span>
        </a>

        <details
          class="disclosure lg:hidden [&[open]_.menu-close]:block [&[open]_.menu-open]:hidden"
        >
          <summary
            class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-steel-edge transition-colors duration-300 hover:bg-surface-sunken"
            aria-label={t('nav.openMenu')}
          >
            <Icon name="ph:list" class="menu-open size-5" aria-hidden="true" />
            <Icon name="ph:x" class="menu-close hidden size-5" aria-hidden="true" />
          </summary>

          <div
            class="m-panel absolute inset-x-0 top-16 border-y border-steel bg-surface-raised shadow-xl shadow-ink/10"
          >
            <ul class="divide-y divide-steel">
              {
                mobileNav.map(({ key, label }) => (
                  <li>
                    <a
                      href={pathFor(key, locale)}
                      class="block px-5 py-4 text-[1.0625rem] transition-colors duration-300 hover:bg-surface-sunken"
                    >
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="p-4">
              <a
                href={telHref(clinic.phone)}
                class="flex min-h-13 items-center justify-center gap-2.5 rounded-full bg-accent px-5 text-accent-contrast"
              >
                <Icon name="ph:phone-call" class="size-5 shrink-0" aria-hidden="true" />
                <span class="measure font-semibold">{clinic.phone}</span>
              </a>
            </div>
          </div>
        </details>
      </div>
    </Container>
  </div>
</header>

<style>
  /* Cùng kiểu gạch chân với mục có menu con, để hàng nav thống nhất. */
  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0.125rem;
    height: 2px;
    border-radius: var(--r-pill);
    background: var(--accent);
    scale: 0 1;
    transition: scale 0.28s var(--ease-out);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    scale: 1 1;
  }
</style>
