---
import {
  DEFAULT_LAYOUT,
  DEFAULT_SKIN,
  LAYOUTS,
  LAYOUT_STORAGE_KEY,
  SKINS,
  SKIN_STORAGE_KEY,
  THEME_STORAGE_KEY,
} from '../lib/appearance';
---

{
  /*
  Chạy CHẶN trong <head>, trước khi trình duyệt vẽ. Không có nó, trang lóe một
  nhịp bằng giao diện mặc định rồi mới nhảy sang giao diện đã chọn. Với ba trục
  thì cú nhảy to hơn hẳn so với chỉ sáng/tối, nên đoạn này càng phải chặn.
  Đây là ngoại lệ JavaScript duy nhất trên đường tải chính (spec §8).
  is:inline bắt buộc: Astro không được bundle hay hoãn đoạn này.

  Danh sách hợp lệ truyền từ TypeScript sang chứ không chép tay lại: giá trị
  trong localStorage là dữ liệu người dùng sửa được. Đọc thẳng vào data-theme mà
  không lọc thì bất kỳ ai cũng đặt được thuộc tính tuỳ ý lên thẻ <html>.
*/
}
<script
  is:inline
  define:vars={{
    themeKey: THEME_STORAGE_KEY,
    skinKey: SKIN_STORAGE_KEY,
    layoutKey: LAYOUT_STORAGE_KEY,
    skins: SKINS,
    layouts: LAYOUTS,
    defaultSkin: DEFAULT_SKIN,
    defaultLayout: DEFAULT_LAYOUT,
  }}
>
  try {
    const root = document.documentElement;
    const pick = (key, allowed, fallback) => {
      const v = localStorage.getItem(key);
      return allowed.includes(v) ? v : fallback;
    };

    const stored = localStorage.getItem(themeKey);
    const dark =
      stored === 'dark' ||
      (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    root.classList.toggle('dark', dark);

    root.dataset.theme = pick(skinKey, skins, defaultSkin);
    root.dataset.layout = pick(layoutKey, layouts, defaultLayout);
  } catch {
    /* localStorage bị chặn (chế độ riêng tư) — để mặc định, không làm hỏng trang */
  }
</script>
