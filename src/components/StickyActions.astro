---
/**
 * Thanh hành động cố định đáy màn hình, chỉ hiện trên mobile.
 *
 * Khách tra cứu nha khoa trên điện thoại thường đọc giữa chừng rồi mới quyết
 * định gọi. Bắt họ cuộn ngược lên đầu trang để tìm nút gọi là mất khách. Thanh
 * này giữ hai kênh liên hệ thật luôn trong tầm ngón tay.
 *
 * Ẩn trên desktop vì header đã có số điện thoại hiện rõ. Trước đây phải ẩn
 * bằng CSS phạm vi component vì display:grid trong khối <style> thắng lg:hidden;
 * bỏ khối style đi thì lg:hidden hoạt động bình thường.
 */
import { Icon } from 'astro-icon/components';
import { clinic, telHref, zaloHref } from '../data/clinic';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div
  role="group"
  class="fixed inset-x-0 bottom-0 z-45 grid grid-cols-2 gap-2.5 border-t border-steel bg-[color-mix(in_srgb,var(--surface-raised)_92%,transparent)] px-3.5 py-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] backdrop-blur-[10px] lg:hidden"
  aria-label={t('cta.call')}
>
  <a
    href={telHref(clinic.phone)}
    class="flex min-h-12 items-center justify-center gap-2 rounded-full bg-accent font-medium text-accent-contrast shadow-[0_6px_16px_-8px_color-mix(in_srgb,var(--accent)_70%,transparent)] transition-colors duration-250 ease-[var(--ease-out)] hover:bg-accent-hover active:translate-y-px"
  >
    <Icon name="ph:phone-call" class="size-5 shrink-0" aria-hidden="true" />
    <span>{t('sticky.call')}</span>
  </a>
  <a
    href={zaloHref(clinic.zalo)}
    class="flex min-h-12 items-center justify-center gap-2 rounded-full border border-steel-edge bg-surface-raised font-medium text-ink transition-colors duration-250 ease-[var(--ease-out)] hover:border-accent hover:text-accent active:translate-y-px"
  >
    <Icon name="simple-icons:zalo" class="size-5 shrink-0" aria-hidden="true" />
    <span>{t('sticky.zalo')}</span>
  </a>
</div>
